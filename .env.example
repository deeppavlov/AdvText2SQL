# Change values below to real values, these are placeholders
DB_USER = "username"
DB_PASS = "password"

# (опционально) хост:порт PG. Обычно не трогаем — SSH-туннель пробрасывает на localhost:5444.
# DB_URL = "localhost:5444"

# ───── LLM provider ─────
# Вариант A: внешний API (OpenRouter / Anthropic-совместимый прокси)
LLM_BASE_URL = "https://my-base-url/api/v1"
LLM_API_KEY = "llm_api_key"
LLM_MODEL_NAME = "model_name"

# Вариант B: локальный inference через LM Studio (для дообученной Qwen3.5-4B)
# Запусти LM Studio → Load model → Local Server → Start.
# Затем закомментируй блок A и раскомментируй блок ниже:
# LLM_BASE_URL = "http://localhost:1234/v1"
# LLM_API_KEY = "lm-studio"          # любая строка — LM Studio не валидирует
# LLM_MODEL_NAME = "qwen35-text2sql" # имя, как видно в LM Studio model picker
