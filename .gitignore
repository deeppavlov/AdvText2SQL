# Python
__pycache__/
.venv/
.ruff_cache/
/.cache/classifier/
*.py[codz]
*$py.class

# Env и секреты
.env
.env.openrouter
.env.*
!.env.example

# Локальные файлы с обнаруженными секретами
/data/launch_db/migrate.sh
/local/old/test.py

# Материалы для защиты
/защита/

# Временные файлы ablation-запусков
.run_single_tmp.*
.ablation_current_feat*
.ablation_tmp.*
query_results.json
# Versioned DeepSeek answers are source data for selector labels and audits.
!/research_results/deepseek_*/**/query_results.json
# OS locks are recreated on launch; they are not experiment results.
/research_results/**/suite.lock

# Промежуточные результаты evaluation
db_schemas.json
all_gold_results.json
all_predicted_results.json

# Логи (большие, в git не нужны — достаточно summary и query_results)
*.log
*.log.[0-9]*
*.log.gz
/logs/
# Журналы запросов и диагностики остаются рядом с локальными результатами.
# Не исключаем все JSONL: data/** и решения селектора нужны для обучения/оценки.
/research_results/**/raw_responses.jsonl
/research_results/**/attempt_history.jsonl
/research_results/**/question_usage.jsonl
/research_results/**/schema_preflight.jsonl
/research_results/**/invalid_outputs.jsonl
/research_results/**/transport_events.jsonl
/research_results/**/monitor_stop.json
/research_results/**/suite_status.json
/research_results/**/key_usage_snapshot.json
# Локальные инструменты и результаты проверки перед коммитом.
/.cache/precommit_review/

# local/ скрипты — трекаем (убрана строка local/*)

# hints/ — автогенерируемые кэши FEAT_26, не нужны в git
hints/

# nl_descriptions/ — автогенерируемые NL-описания FEAT_23
nl_descriptions/

# Старые/устаревшие папки результатов
ablation_results/_hybrid
ablation_results/feat_00_baseline_both
ablation_results/feat_00_baseline_both_base
presentations/

plan.md
docs/security_review.md
docs/13_ilya_repository_review.md
