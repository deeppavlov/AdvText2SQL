35\u0440\u0435\u0437 \u0434\u0432\u043e\u0439\u043d\u044b\u0435 \u043a\u0430\u0432\u044b\u0447\u043a\u0438. \u0421\u0438\u043d\u0442\u0430\u043a\u0441\u0438\u0441 PostgreSQL.\n\n\u0418\u0442\u0430\u043a, \u0437\u0430\u043f\u0440\u043e\u0441:\n\n/* \u041f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043d\u044b\u0445 \u043d\u043e\u043c\u0435\u0440\u043e\u0432 \u0448\u043a\u043e\u043b \u0441 \u0442\u043e\u043f-3 \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044e excellence rate */\nSELECT DISTINCT sc.phone\nFROM schools sc\nJOIN satscores ss ON sc.cdscode = ss.cds\nWHERE ss.numtsttakr > 0\nORDER BY (ss.numge1500::numeric / ss.numtsttakr::numeric) DESC\nLIMIT 3;\n\n\u041d\u043e \u043d\u0443\u0436\u043d\u043e \u0443\u0431\u0435\u0434\u0438\u0442\u044c\u0441\u044f, \u0447\u0442\u043e cds \u0438 cdscode \u2014 \u044d\u0442\u043e \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u044b\u0435 \u043f\u043e\u043b\u044f, \u043e\u043d\u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0441\u043e\u0432\u043f\u0430\u0434\u0430\u0442\u044c. \u0422\u0430\u043a\u0436\u0435, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0432 \u0442\u0430\u0431\u043b\u0438\u0446\u0435 schools \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u043f\u0438\u0441\u0435\u0439 \u0441 \u043e\u0434\u043d\u0438\u043c cdscode? \u041e\u0431\u044b\u0447\u043d\u043e cdscode \u0443\u043d\u0438\u043a\u0430\u043b\u0435\u043d. \u041d\u043e \u0434\u043b\u044f \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0433\u043e JOIN \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c ON sc.cdscode = ss.cds.\n\n\u0422\u0430\u043a\u0436\u0435, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0443\u0436\u043d\u043e \u0443\u0447\u0435\u0441\u0442\u044c, \u0447\u0442\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0448\u043a\u043e\u043b\u044b \u043c\u043e\u0433\u0443\u0442 \u043d\u0435 \u0438\u043c\u0435\u0442\u044c \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430? \u0422\u043e\u0433\u0434\u0430 \u043e\u043d\u0438 \u043d\u0435 \u0431\u0443\u0434\u0443\u0442 \u0432\u044b\u0432\u0435\u0434\u0435\u043d\u044b. \u041d\u043e \u0437\u0430\u043f\u0440\u043e\u0441 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0441\u043f\u0438\u0441\u043e\u043a \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043d\u044b\u0445 \u043d\u043e\u043c\u0435\u0440\u043e\u0432. \u0415\u0441\u043b\u0438 \u0443 \u0448\u043a\u043e\u043b\u044b \u043d\u0435\u0442 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430, \u043e\u043d\u0430 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u0430 \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0442\u044c\u0441\u044f? \u041f\u043e-\u0445\u043e\u0440\u043e\u0448\u0435\u043c\u0443, \u043d\u0443\u0436\u043d\u043e \u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0435, \u0443 \u043a\u043e\u0433\u043e phone \u043d\u0435 NULL. \u041c\u043e\u0436\u043d\u043e \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0443\u0441\u043b\u043e\u0432\u0438\u0435 sc.phone IS NOT NULL.\n\n\u0422\u0430\u043a\u0436\u0435, \u0435\u0441\u043b\u0438 \u0432 satscores \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u043f\u0438\u0441\u0435\u0439 \u043d\u0430 \u043e\u0434\u043d\u0443 \u0448\u043a\u043e\u043b\u0443 (\u0440\u0430\u0437\u043d\u044b\u0435 rtype), \u0442\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435 rate \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u044b\u043c. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0443\u0436\u043d\u043e \u0431\u0440\u0430\u0442\u044c \u043e\u0434\u043d\u0443 \u0437\u0430\u043f\u0438\u0441\u044c \u043d\u0430 \u0448\u043a\u043e\u043b\u0443. \u041d\u043e \u0432 \u0443\u0441\u043b\u043e\u0432\u0438\u0438 \u043d\u0435\u0442 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u044f. \u041e\u0441\u0442\u0430\u0432\u0438\u043c \u043a\u0430\u043a \u0435\u0441\u0442\u044c: \u0435\u0441\u043b\u0438 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u043f\u0438\u0441\u0435\u0439, \u0442\u043e \u043a\u0430\u0436\u0434\u0430\u044f \u0431\u0443\u0434\u0435\u0442 \u0434\u0430\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0439 rate, \u0438 \u0448\u043a\u043e\u043b\u0430 \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u043f\u0430\u0441\u0442\u044c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0437, \u043d\u043e DISTINCT \u043f\u043e phone \u0443\u0431\u0435\u0440\u0435\u0442 \u0434\u0443\u0431\u043b\u0438\u043a\u0430\u0442\u044b, \u043d\u043e \u0442\u043e\u043f-3 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0432\u044b\u0431\u0440\u0430\u043d\u043e \u043d\u0435\u0432\u0435\u0440\u043d\u043e (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043e\u0434\u043d\u0430 \u0448\u043a\u043e\u043b\u0430 \u0441 \u0434\u0432\u0443\u043c\u044f \u0440\u0430\u0437\u043d\u044b\u043c\u0438 rate \u043c\u043e\u0436\u0435\u0442 \u0434\u0430\u0442\u044c \u0434\u0432\u0430 \u043c\u0435\u0441\u0442\u0430). \u041b\u0443\u0447\u0448\u0435 \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u0433\u0440\u0443\u043f\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u043e \u0448\u043a\u043e\u043b\u0435, \u0432\u0437\u044f\u0442\u044c \u0441\u0440\u0435\u0434\u043d\u0435\u0435 \u0438\u043b\u0438 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435? \u041d\u043e evidence \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043f\u0440\u043e\u0441\u0442\u043e \"Excellence rate = NumGE1500 / NumTstTakr\", \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e, \u043a\u0430\u0436\u0434\u0430\u044f \u0448\u043a\u043e\u043b\u0430 \u0438\u043c\u0435\u0435\u0442 \u043e\u0434\u043d\u0443 \u0437\u0430\u043f\u0438\u0441\u044c. \u041f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u043c, \u0447\u0442\u043e \u043d\u0435\u0442.\n\n\u0411\u043e\u043b\u0435\u0435 \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u043e: \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u044c rate \u0434\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0433\u043e cdscode \u0438 \u0437\u0430\u0442\u0435\u043c \u0432\u0437\u044f\u0442\u044c \u0442\u043e\u043f-3. \u041c\u043e\u0436\u0435\u0442, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043f\u043e\u0434\u0437\u0430\u043f\u0440\u043e\u0441, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0433\u0440\u0443\u043f\u043f\u0438\u0440\u0443\u0435\u0442 \u043f\u043e cds \u0438 \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u0435\u0442 \u0441\u0443\u043c\u043c\u0443? \u041d\u043e \u043d\u0435\u0442 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u044f. \u0414\u043e\u043f\u0443\u0441\u0442\u0438\u043c, \u0447\u0442\u043e \u0432 satscores \u043a\u0430\u0436\u0434\u0430\u044f \u0448\u043a\u043e\u043b\u0430 \u0438\u043c\u0435\u0435\u0442 \u043e\u0434\u043d\u0443 \u0437\u0430\u043f\u0438\u0441\u044c. \u042f \u043d\u0435 \u0431\u0443\u0434\u0443 \u0443\u0441\u043b\u043e\u0436\u043d\u044f\u0442\u044c.\n\n\u0418\u0442\u0430\u043a, \u0444\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439 SQL:\n\n/* \u0421\u043f\u0438\u0441\u043e\u043a \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043d\u044b\u0445 \u043d\u043e\u043c\u0435\u0440\u043e\u0432 \u0448\u043a\u043e\u043b \u0441 \u043d\u0430\u0438\u0432\u044b\u0441\u0448\u0438\u043c\u0438 3 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f\u043c\u0438 excellence rate (numge1500/numtsttakr) */\nSELECT DISTINCT sc.phone\nFROM schools sc\nJOIN satscores ss ON sc.cdscode = ss.cds\nWHERE ss.numtsttakr > 0 AND sc.phone IS NOT NULL\nORDER BY (ss.numge1500::numeric / ss.numtsttakr::numeric) DESC\nLIMIT 3;\n\n\u041d\u043e \u043d\u0443\u0436\u043d\u043e \u044d\u043a\u0440\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f \u0441\u0442\u043e\u043b\u0431\u0446\u043e\u0432? \u0412 PostgreSQL \u0434\u0432\u043e\u0439\u043d\u044b\u0435 \u043a\u0430\u0432\u044b\u0447\u043a\u0438 \u043d\u0443\u0436\u043d\u044b, \u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c \u043f\u0440\u043e\u0431\u0435\u043b\u044b \u0438\u043b\u0438 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0441\u043b\u043e\u0432\u0430. \u0417\u0434\u0435\u0441\u044c \u043d\u0435\u0442, \u043d\u043e \u043f\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u0443 \"\u0412\u0441\u0435\u0433\u0434\u0430 \u044d\u043a\u0440\u0430\u043d\u0438\u0440\u0443\u0439 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u043e\u0439\u043d\u044b\u0435 \u043a\u0430\u0432\u044b\u0447\u043a\u0438\" \u2014 \u044d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0438\u0437\u0431\u044b\u0442\u043e\u0447\u043d\u043e, \u043d\u043e \u0441\u043b\u0435\u0434\u0443\u0435\u0442. \u041f\u043e\u044d\u0442\u043e\u043c\u0443:\n\nSELECT DISTINCT sc.\"phone\"\nFROM \"schools\" sc\nJOIN \"satscores\" ss ON sc.\"cdscode\" = ss.\"cds\"\nWHERE ss.\"numtsttakr\" > 0 AND sc.\"phone\" IS NOT NULL\nORDER BY (ss.\"numge1500\"::numeric / ss.\"numtsttakr\"::numeric) DESC\nLIMIT 3;\n\n\u0422\u0430\u043a\u0436\u0435, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0432 \u0442\u0430\u0431\u043b\u0438\u0446\u0430\u0445 \u0435\u0441\u0442\u044c \u0434\u0440\u0443\u0433\u0438\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f, \u043d\u043e \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0441\u0445\u0435\u043c\u0435, \u0432\u0441\u0435 \u043f\u043e\u043b\u044f \u0431\u0435\u0437 \u043f\u0440\u043e\u0431\u0435\u043b\u043e\u0432. \n\n\u0423\u0447\u0442\u0435\u043c, \u0447\u0442\u043e \u0432 \u0441\u0445\u0435\u043c\u0435 \u0435\u0441\u0442\u044c \"Enrollment (K-12)\" \u0441 \u043f\u0440\u043e\u0431\u0435\u043b\u0430\u043c\u0438, \u043d\u043e \u0432 \u0434\u0430\u043d\u043d\u043e\u043c \u0437\u0430\u043f\u0440\u043e\u0441\u0435 \u043e\u043d\u0438 \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f.\n\n\u042f \u0434\u0443\u043c\u0430\u044e, \u044d\u0442\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u044b\u0439 \u043e\u0442\u0432\u0435\u0442.", "reasoning_details": [{"type": "reasoning.text", "text": "\u041c\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u0442\u044c \u0437\u0430\u043f\u0440\u043e\u0441 \u043d\u0430 \u0440\u0443\u0441\u0441\u043a\u043e\u043c \u044f\u0437\u044b\u043a\u0435 \u0432 SQL. \u0417\u0430\u043f\u0440\u043e\u0441: \"Please list the phone numbers of the schools with the top 3 SAT excellence rate.\" evidence: \"Excellence rate = NumGE1500 / NumTstTakr\".\n\n\u0418\u0442\u0430\u043a, \u043d\u0443\u0436\u043d\u043e \u043d\u0430\u0439\u0442\u0438 \u0448\u043a\u043e\u043b\u044b \u0441 \u0442\u043e\u043f-3 \u043f\u043e excellence rate, \u0438 \u0432\u044b\u0432\u0435\u0441\u0442\u0438 \u0438\u0445 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043d\u044b\u0435 \u043d\u043e\u043c\u0435\u0440\u0430.\n\n\u0422\u0430\u0431\u043b\u0438\u0446\u044b: satscores \u0438 schools. \u0412 satscores \u0435\u0441\u0442\u044c cds (\u043a\u043b\u044e\u0447?), rtype, sname, dname, cname, enroll12, numtsttakr, avgscrread, avgscrmath, avgscrwrite, numge1500. \u0412 schools \u0435\u0441\u0442\u044c cdscode (\u043f\u043e\u0445\u043e\u0436\u0435, \u0447\u0442\u043e \u044d\u0442\u043e \u0430\u043d\u0430\u043b\u043e\u0433 cds? \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0441\u0432\u044f\u0437\u044c \u043f\u043e cds = cdscode \u0438\u043b\u0438 \u043f\u043e \u0438\u043c\u0435\u043d\u0438 \u0448\u043a\u043e\u043b\u044b? \u041d\u043e \u0432 schools \u0435\u0441\u0442\u044c school, district, county. \u0412 satscores \u0435\u0441\u0442\u044c sname, dname, cname. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0441\u0432\u044f\u0437\u044c \u043f\u043e cds = cdscode, \u0442\u0430\u043a \u043a\u0430\u043a cds, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u043a\u043e\u0434 \u0448\u043a\u043e\u043b\u044b. \u0412 satscores \u0442\u0430\u043a\u0436\u0435 \u0435\u0441\u0442\u044c cds, \u043a\u043e\u0442\u043e\u0440\u044b\u0439, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 cdscode. \u0411\u0443\u0434\u0435\u043c \u0441\u043e\u0435\u0434\u0438\u043d\u044f\u0442\u044c \u043f\u043e cds = cdscode.\n\nExcellence rate = numge1500 / numtsttakr. \u041d\u0430\u043c \u043d\u0443\u0436\u043d\u043e \u0442\u043e\u043f-3 \u043f\u043e \u044d\u0442\u043e\u043c\u0443 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044e. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c ORDER BY rate DESC LIMIT 3. \u041d\u043e \u043d\u0443\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u043e\u0441\u0442\u043e\u0440\u043e\u0436\u043d\u044b\u043c \u0441 \u0434\u0435\u043b\u0435\u043d\u0438\u0435\u043c \u043d\u0430 \u043d\u043e\u043b\u044c. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c NULLIF(numtsttakr, 0). \u0422\u0430\u043a\u0436\u0435 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c, \u0447\u0442\u043e numtsttakr = 0, \u0442\u043e\u0433\u0434\u0430 rate \u0431\u0443\u0434\u0435\u0442 NULL, \u0442\u0430\u043a\u0438\u0435 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u044b \u043f\u043e\u043f\u0430\u0441\u0442\u044c \u0432 \u0442\u043e\u043f. \u041c\u043e\u0436\u0435\u0442, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c WHERE numtsttakr > 0.\n\n\u0422\u0430\u043a\u0436\u0435 \u043d\u0443\u0436\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c DISTINCT? \u041d\u0435\u0442, \u0437\u0434\u0435\u0441\u044c \u043d\u0443\u0436\u043d\u043e \u0432\u044b\u0432\u0435\u0441\u0442\u0438 phone numbers \u0448\u043a\u043e\u043b. \u041e\u0434\u043d\u0430 \u0448\u043a\u043e\u043b\u0430 \u043c\u043e\u0436\u0435\u0442 \u0438\u043c\u0435\u0442\u044c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u043f\u0438\u0441\u0435\u0439 \u0432 satscores? \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043a\u0430\u0436\u0434\u0430\u044f \u0448\u043a\u043e\u043b\u0430 \u0438\u043c\u0435\u0435\u0442 \u043e\u0434\u043d\u0443 \u0437\u0430\u043f\u0438\u0441\u044c? \u041d\u043e \u0432 satscores \u0435\u0441\u0442\u044c rtype \u2014 \u0442\u0438\u043f \u043e\u0442\u0447\u0435\u0442\u0430? \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0442\u0438\u043f\u043e\u0432. \u0422\u043e\u0433\u0434\u0430 \u043d\u0443\u0436\u043d\u043e \u0432\u0437\u044f\u0442\u044c, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0438\u043b\u0438 \u0430\u0433\u0440\u0435\u0433\u0438\u0440\u043e\u0432\u0430\u0442\u044c? \u041d\u043e \u0437\u0430\u043f\u0440\u043e\u0441 \u043d\u0435 \u0443\u0442\u043e\u0447\u043d\u044f\u0435\u0442. \u0414\u043e\u043f\u0443\u0441\u0442\u0438\u043c, \u0447\u0442\u043e \u043a\u0430\u0436\u0434\u0430\u044f \u0448\u043a\u043e\u043b\u0430 \u0438\u043c\u0435\u0435\u0442 \u043e\u0434\u043d\u0443 \u0437\u0430\u043f\u0438\u0441\u044c. \u0415\u0441\u043b\u0438 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e, \u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0432\u044b\u0434\u0430\u0442\u044c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043e\u0432 \u0434\u043b\u044f \u043e\u0434\u043d\u043e\u0439 \u0448\u043a\u043e\u043b\u044b? \u041b\u0443\u0447\u0448\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c DISTINCT, \u043d\u043e \u0437\u0430\u043f\u0440\u043e\u0441 \u043f\u0440\u043e\u0441\u0438\u0442 phone numbers, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0443\u0436\u043d\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0435. \u041d\u043e schools.phone \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u043c \u0434\u043b\u044f \u0440\u0430\u0437\u043d\u044b\u0445 \u0448\u043a\u043e\u043b? \u0412\u0440\u044f\u0434 \u043b\u0438. \u041e\u0434\u043d\u0430\u043a\u043e, \u0447\u0442\u043e\u0431\u044b \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044c \u0434\u0443\u0431\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c DISTINCT.\n\n\u041f\u043e\u0440\u044f\u0434\u043e\u043a: \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u0435\u043c rate, \u0441\u043e\u0440\u0442\u0438\u0440\u0443\u0435\u043c, \u0431\u0435\u0440\u0435\u043c \u0442\u043e\u043f-3, \u0437\u0430\u0442\u0435\u043c \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u043c phone \u0438\u0437 schools.\n\n\u0412\u0430\u0436\u043d\u043e: \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c \u0430\u043b\u0438\u0430\u0441\u044b, \u044d\u043a\u0440\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u043e\u0439\u043d\u044b\u0435 \u043a\u0430\u0432\u044b\u0447\u043a\u0438. \u0421\u0438\u043d\u0442\u0430\u043a\u0441\u0438\u0441 PostgreSQL.\n\n\u0418\u0442\u0430\u043a, \u0437\u0430\u043f\u0440\u043e\u0441:\n\n/* \u041f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043d\u044b\u0445 \u043d\u043e\u043c\u0435\u0440\u043e\u0432 \u0448\u043a\u043e\u043b \u0441 \u0442\u043e\u043f-3 \u043f\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044e excellence rate */\nSELECT DISTINCT sc.phone\nFROM schools sc\nJOIN satscores ss ON sc.cdscode = ss.cds\nWHERE ss.numtsttakr > 0\nORDER BY (ss.numge1500::numeric / ss.numtsttakr::numeric) DESC\nLIMIT 3;\n\n\u041d\u043e \u043d\u0443\u0436\u043d\u043e \u0443\u0431\u0435\u0434\u0438\u0442\u044c\u0441\u044f, \u0447\u0442\u043e cds \u0438 cdscode \u2014 \u044d\u0442\u043e \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u044b\u0435 \u043f\u043e\u043b\u044f, \u043e\u043d\u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0441\u043e\u0432\u043f\u0430\u0434\u0430\u0442\u044c. \u0422\u0430\u043a\u0436\u0435, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0432 \u0442\u0430\u0431\u043b\u0438\u0446\u0435 schools \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u043f\u0438\u0441\u0435\u0439 \u0441 \u043e\u0434\u043d\u0438\u043c cdscode? \u041e\u0431\u044b\u0447\u043d\u043e cdscode \u0443\u043d\u0438\u043a\u0430\u043b\u0435\u043d. \u041d\u043e \u0434\u043b\u044f \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0433\u043e JOIN \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c ON sc.cdscode = ss.cds.\n\n\u0422\u0430\u043a\u0436\u0435, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0443\u0436\u043d\u043e \u0443\u0447\u0435\u0441\u0442\u044c, \u0447\u0442\u043e \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0448\u043a\u043e\u043b\u044b \u043c\u043e\u0433\u0443\u0442 \u043d\u0435 \u0438\u043c\u0435\u0442\u044c \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430? \u0422\u043e\u0433\u0434\u0430 \u043e\u043d\u0438 \u043d\u0435 \u0431\u0443\u0434\u0443\u0442 \u0432\u044b\u0432\u0435\u0434\u0435\u043d\u044b. \u041d\u043e \u0437\u0430\u043f\u0440\u043e\u0441 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0441\u043f\u0438\u0441\u043e\u043a \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043d\u044b\u0445 \u043d\u043e\u043c\u0435\u0440\u043e\u0432. \u0415\u0441\u043b\u0438 \u0443 \u0448\u043a\u043e\u043b\u044b \u043d\u0435\u0442 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430, \u043e\u043d\u0430 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u0430 \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0442\u044c\u0441\u044f? \u041f\u043e-\u0445\u043e\u0440\u043e\u0448\u0435\u043c\u0443, \u043d\u0443\u0436\u043d\u043e \u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u0442\u0435, \u0443 \u043a\u043e\u0433\u043e phone \u043d\u0435 NULL. \u041c\u043e\u0436\u043d\u043e \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0443\u0441\u043b\u043e\u0432\u0438\u0435 sc.phone IS NOT NULL.\n\n\u0422\u0430\u043a\u0436\u0435, \u0435\u0441\u043b\u0438 \u0432 satscores \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u043f\u0438\u0441\u0435\u0439 \u043d\u0430 \u043e\u0434\u043d\u0443 \u0448\u043a\u043e\u043b\u0443 (\u0440\u0430\u0437\u043d\u044b\u0435 rtype), \u0442\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u0435 rate \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u044b\u043c. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0443\u0436\u043d\u043e \u0431\u0440\u0430\u0442\u044c \u043e\u0434\u043d\u0443 \u0437\u0430\u043f\u0438\u0441\u044c \u043d\u0430 \u0448\u043a\u043e\u043b\u0443. \u041d\u043e \u0432 \u0443\u0441\u043b\u043e\u0432\u0438\u0438 \u043d\u0435\u0442 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u044f. \u041e\u0441\u0442\u0430\u0432\u0438\u043c \u043a\u0430\u043a \u0435\u0441\u0442\u044c: \u0435\u0441\u043b\u0438 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u043f\u0438\u0441\u0435\u0439, \u0442\u043e \u043a\u0430\u0436\u0434\u0430\u044f \u0431\u0443\u0434\u0435\u0442 \u0434\u0430\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0439 rate, \u0438 \u0448\u043a\u043e\u043b\u0430 \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u043f\u0430\u0441\u0442\u044c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0437, \u043d\u043e DISTINCT \u043f\u043e phone \u0443\u0431\u0435\u0440\u0435\u0442 \u0434\u0443\u0431\u043b\u0438\u043a\u0430\u0442\u044b, \u043d\u043e \u0442\u043e\u043f-3 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0432\u044b\u0431\u0440\u0430\u043d\u043e \u043d\u0435\u0432\u0435\u0440\u043d\u043e (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043e\u0434\u043d\u0430 \u0448\u043a\u043e\u043b\u0430 \u0441 \u0434\u0432\u0443\u043c\u044f \u0440\u0430\u0437\u043d\u044b\u043c\u0438 rate \u043c\u043e\u0436\u0435\u0442 \u0434\u0430\u0442\u044c \u0434\u0432\u0430 \u043c\u0435\u0441\u0442\u0430). \u041b\u0443\u0447\u0448\u0435 \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u0433\u0440\u0443\u043f\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u043e \u0448\u043a\u043e\u043b\u0435, \u0432\u0437\u044f\u0442\u044c \u0441\u0440\u0435\u0434\u043d\u0435\u0435 \u0438\u043b\u0438 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435? \u041d\u043e evidence \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043f\u0440\u043e\u0441\u0442\u043e \"Excellence rate = NumGE1500 / NumTstTakr\", \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e, \u043a\u0430\u0436\u0434\u0430\u044f \u0448\u043a\u043e\u043b\u0430 \u0438\u043c\u0435\u0435\u0442 \u043e\u0434\u043d\u0443 \u0437\u0430\u043f\u0438\u0441\u044c. \u041f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u043c, \u0447\u0442\u043e \u043d\u0435\u0442.\n\n\u0411\u043e\u043b\u0435\u0435 \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u043e: \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u044c rate \u0434\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0433\u043e cdscode \u0438 \u0437\u0430\u0442\u0435\u043c \u0432\u0437\u044f\u0442\u044c \u0442\u043e\u043f-3. \u041c\u043e\u0436\u0435\u0442, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043f\u043e\u0434\u0437\u0430\u043f\u0440\u043e\u0441, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0433\u0440\u0443\u043f\u043f\u0438\u0440\u0443\u0435\u0442 \u043f\u043e cds \u0438 \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u0435\u0442 \u0441\u0443\u043c\u043c\u0443? \u041d\u043e \u043d\u0435\u0442 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u044f. \u0414\u043e\u043f\u0443\u0441\u0442\u0438\u043c, \u0447\u0442\u043e \u0432 satscores \u043a\u0430\u0436\u0434\u0430\u044f \u0448\u043a\u043e\u043b\u0430 \u0438\u043c\u0435\u0435\u0442 \u043e\u0434\u043d\u0443 \u0437\u0430\u043f\u0438\u0441\u044c. \u042f \u043d\u0435 \u0431\u0443\u0434\u0443 \u04