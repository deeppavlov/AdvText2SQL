\u0430\u0442\u0435\u043b\u044f \u043d\u0430 \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c. \u0417\u0430\u043f\u0440\u043e\u0441: \"Rank schools by their average score in Writing where the score is greater than 499, showing their charter numbers.\" Evidence: \"Valid charter number means the number is not null\".\n\n\u0421\u043c\u043e\u0442\u0440\u0438\u043c \u043d\u0430 \u0441\u0445\u0435\u043c\u0443: \u0435\u0441\u0442\u044c \u0442\u0430\u0431\u043b\u0438\u0446\u0430 satscores \u0441 \u043f\u043e\u043b\u044f\u043c\u0438 avgscrwrite (BIGINT) - \u044d\u0442\u043e \u0441\u0440\u0435\u0434\u043d\u0438\u0439 \u0431\u0430\u043b\u043b \u043f\u043e \u043f\u0438\u0441\u044c\u043c\u0443. \u0422\u0430\u043a\u0436\u0435 \u0435\u0441\u0442\u044c \u0442\u0430\u0431\u043b\u0438\u0446\u0430 schools \u0441 \u043f\u043e\u043b\u0435\u043c charter (BIGINT) \u0438 charternum (TEXT). \u0412 \u0437\u0430\u043f\u0440\u043e\u0441\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u043e \"charter numbers\" - \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0438\u043c\u0435\u0435\u0442\u0441\u044f \u0432 \u0432\u0438\u0434\u0443 charternum. \u0422\u0430\u043a\u0436\u0435 \u0435\u0441\u0442\u044c \u0443\u0441\u043b\u043e\u0432\u0438\u0435 \"where the score is greater than 499\" - \u044d\u0442\u043e \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f \u043a avgscrwrite. \"Rank schools by their average score in Writing\" - \u043d\u0443\u0436\u043d\u043e \u0440\u0430\u043d\u0436\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0448\u043a\u043e\u043b\u044b \u043f\u043e \u0441\u0440\u0435\u0434\u043d\u0435\u043c\u0443 \u0431\u0430\u043b\u043b\u0443 \u043f\u043e \u043f\u0438\u0441\u044c\u043c\u0443. \u041d\u043e \u0432 \u0442\u0430\u0431\u043b\u0438\u0446\u0435 satscores \u0443\u0436\u0435 \u0435\u0441\u0442\u044c avgscrwrite - \u044d\u0442\u043e \u0441\u0440\u0435\u0434\u043d\u0438\u0439 \u0431\u0430\u043b\u043b \u043f\u043e \u0448\u043a\u043e\u043b\u0435? \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u044d\u0442\u043e \u0443\u0436\u0435 \u0441\u0440\u0435\u0434\u043d\u0435\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435. \u0417\u0430\u043f\u0440\u043e\u0441 \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \"average score in Writing\" - \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c, \u043d\u0443\u0436\u043d\u043e \u0432\u0437\u044f\u0442\u044c \u0441\u0440\u0435\u0434\u043d\u0435\u0435 \u0438\u0437 avgscrwrite? \u041d\u043e avgscrwrite \u0443\u0436\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0441\u0440\u0435\u0434\u043d\u0438\u043c \u0431\u0430\u043b\u043b\u043e\u043c. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0443\u0436\u043d\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u044d\u0442\u043e \u043f\u043e\u043b\u0435. \u0422\u0430\u043a\u0436\u0435 \u043d\u0443\u0436\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c charter numbers. \u0414\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043d\u0443\u0436\u043d\u043e \u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u044c \u0442\u0430\u0431\u043b\u0438\u0446\u044b satscores \u0438 schools \u043f\u043e cds \u0438 cdscode? \u0412 satscores \u0435\u0441\u0442\u044c cds, \u0432 schools \u0435\u0441\u0442\u044c cdscode. \u0412\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u044d\u0442\u043e \u043a\u043b\u044e\u0447.\n\n\u041d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u0438: \n- \"Rank schools\" - \u043a\u0430\u043a \u0440\u0430\u043d\u0436\u0438\u0440\u043e\u0432\u0430\u0442\u044c? \u041f\u043e \u0443\u0431\u044b\u0432\u0430\u043d\u0438\u044e \u0438\u043b\u0438 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u044e? \u041e\u0431\u044b\u0447\u043d\u043e \u043f\u043e\u0434\u0440\u0430\u0437\u0443\u043c\u0435\u0432\u0430\u0435\u0442\u0441\u044f \u043e\u0442 \u043b\u0443\u0447\u0448\u0435\u0433\u043e \u043a \u0445\u0443\u0434\u0448\u0435\u043c\u0443, \u043d\u043e \u043d\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u043e \u044f\u0432\u043d\u043e. \u041e\u0434\u043d\u0430\u043a\u043e \u0432 SQL \u0440\u0430\u043d\u0436\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u0431\u044b\u0447\u043d\u043e \u043f\u043e\u0434\u0440\u0430\u0437\u0443\u043c\u0435\u0432\u0430\u0435\u0442 ORDER BY, \u0438 \u043c\u043e\u0436\u043d\u043e \u0443\u043a\u0430\u0437\u0430\u0442\u044c DESC. \u041d\u043e \u0437\u0430\u043f\u0440\u043e\u0441 \u043d\u0435 \u0443\u0442\u043e\u0447\u043d\u044f\u0435\u0442 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435. \u042d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c\u044e. \n- \"average score in Writing\" - \u0432 \u0442\u0430\u0431\u043b\u0438\u0446\u0435 \u0435\u0441\u0442\u044c avgscrwrite, \u043d\u043e \u044d\u0442\u043e \u0443\u0436\u0435 \u0441\u0440\u0435\u0434\u043d\u0435\u0435. \u0415\u0441\u043b\u0438 \u043d\u0443\u0436\u043d\u043e \u0440\u0430\u043d\u0436\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u043e \u044d\u0442\u043e\u043c\u0443 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044e, \u0442\u043e \u0432\u0441\u0451 \u043e\u043a. \u041d\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c, \u043d\u0443\u0436\u043d\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u044c \u0441\u0440\u0435\u0434\u043d\u0435\u0435 \u043f\u043e \u0432\u0441\u0435\u043c \u0442\u0435\u0441\u0442\u0430\u043c? \u041d\u0435\u0442, \u0441\u043a\u0430\u0437\u0430\u043d\u043e \"their average score in Writing\" - \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u044d\u0442\u043e \u0438 \u0435\u0441\u0442\u044c avgscrwrite.\n- \"where the score is greater than 499\" - score \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f \u043a Writing? \u0414\u0430, \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e.\n- \"showing their charter numbers\" - \u043d\u0443\u0436\u043d\u043e \u0432\u044b\u0432\u0435\u0441\u0442\u0438 charternum. \u041d\u043e \u0432 evidence \u0441\u043a\u0430\u0437\u0430\u043d\u043e \"Valid charter number means the number is not null\" - \u044d\u0442\u043e \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u0435, \u0447\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0435 null. \u041d\u043e \u0432 \u0437\u0430\u043f\u0440\u043e\u0441\u0435 \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u043e \u0444\u0438\u043b\u044c\u0442\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u043e null, \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0443\u0436\u043d\u043e \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0443\u0441\u043b\u043e\u0432\u0438\u0435, \u0447\u0442\u043e charternum IS NOT NULL? \u041d\u043e evidence \u0433\u043e\u0432\u043e\u0440\u0438\u0442, \u0447\u0442\u043e \u044d\u0442\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435, \u0430 \u043d\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0435. \u041e\u0434\u043d\u0430\u043a\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c: \u043d\u0443\u0436\u043d\u043e \u043b\u0438 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u0448\u043a\u043e\u043b\u044b \u0441 \u0432\u0430\u043b\u0438\u0434\u043d\u044b\u043c charter number? \u0417\u0430\u043f\u0440\u043e\u0441 \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \"showing their charter numbers\" - \u043f\u043e\u0434\u0440\u0430\u0437\u0443\u043c\u0435\u0432\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u0443 \u043a\u0430\u0436\u0434\u043e\u0439 \u0448\u043a\u043e\u043b\u044b \u0435\u0441\u0442\u044c charter number, \u043d\u043e \u0435\u0441\u043b\u0438 \u043e\u043d null, \u0442\u043e \u0447\u0442\u043e \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c? \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0443\u0436\u043d\u043e \u043e\u0442\u0444\u0438\u043b\u044c\u0442\u0440\u043e\u0432\u0430\u0442\u044c. \u041d\u043e evidence \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \"Valid charter number means the number is not null\" - \u044d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u043e\u0439, \u0447\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0435 null. \u041d\u043e \u0432 \u0441\u0430\u043c\u043e\u043c \u0437\u0430\u043f\u0440\u043e\u0441\u0435 \u043d\u0435\u0442 \u044f\u0432\u043d\u043e\u0433\u043e \u0444\u0438\u043b\u044c\u0442\u0440\u0430. \u042d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c\u044e.\n\n\u0422\u0430\u043a\u0436\u0435 \u043d\u0443\u0436\u043d\u043e \u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u044c \u0442\u0430\u0431\u043b\u0438\u0446\u044b. \u0412 \u0437\u0430\u043f\u0440\u043e\u0441\u0435 \u043d\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u043e, \u043a\u0430\u043a \u0441\u043e\u0435\u0434\u0438\u043d\u044f\u0442\u044c. \u041d\u043e \u043f\u043e \u0441\u0445\u0435\u043c\u0435 \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u044c, \u0447\u0442\u043e cds \u0432 satscores \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 cdscode \u0432 schools. \u042d\u0442\u043e \u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e.\n\n\u0415\u0449\u0451: \"Rank schools\" - \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0443\u0436\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043e\u043a\u043e\u043d\u043d\u0443\u044e \u0444\u0443\u043d\u043a\u0446\u0438\u044e RANK() \u0438\u043b\u0438 \u043f\u0440\u043e\u0441\u0442\u043e ORDER BY? \u041e\u0431\u044b\u0447\u043d\u043e \"rank\" \u043f\u043e\u0434\u0440\u0430\u0437\u0443\u043c\u0435\u0432\u0430\u0435\u0442 \u043f\u0440\u0438\u0441\u0432\u043e\u0435\u043d\u0438\u0435 \u0440\u0430\u043d\u0433\u0430. \u041d\u043e \u0432 SQL \u043c\u043e\u0436\u043d\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c RANK() OVER (ORDER BY avgscrwrite DESC). \u041d\u043e \u0435\u0441\u043b\u0438 \u043f\u0440\u043e\u0441\u0442\u043e ORDER BY, \u0442\u043e \u044d\u0442\u043e \u0441\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0430, \u0430 \u043d\u0435 \u0440\u0430\u043d\u0436\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0441 \u043d\u043e\u043c\u0435\u0440\u0430\u043c\u0438. \u0417\u0430\u043f\u0440\u043e\u0441 \u043d\u0435 \u0443\u0442\u043e\u0447\u043d\u044f\u0435\u0442, \u043d\u0443\u0436\u043d\u043e \u043b\u0438 \u0432\u044b\u0432\u043e\u0434\u0438\u0442\u044c \u043d\u043e\u043c\u0435\u0440 \u0440\u0430\u043d\u0433\u0430. \u042d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c\u044e.\n\n\u0412 \u0446\u0435\u043b\u043e\u043c, \u0435\u0441\u0442\u044c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u0435\u0439: \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0440\u0430\u043d\u0436\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f, \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c \u0444\u0438\u043b\u044c\u0442\u0440\u0430 \u043f\u043e null charter number, \u0438 \u043d\u0443\u0436\u043d\u043e \u043b\u0438 \u0432\u044b\u0432\u043e\u0434\u0438\u0442\u044c \u0440\u0430\u043d\u0433 \u0438\u043b\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u0441\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c. \u041e\u0434\u043d\u0430\u043a\u043e, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0432 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0435 \u0437\u0430\u0434\u0430\u0447\u0438 \"Rank schools\" \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u0441\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u043e \u0443\u0431\u044b\u0432\u0430\u043d\u0438\u044e. \u041d\u043e \u043b\u0443\u0447\u0448\u0435 \u0443\u0442\u043e\u0447\u043d\u0438\u0442\u044c.\n\n\u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438, \u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c, \u043d\u0443\u0436\u043d\u043e \u043e\u0442\u0432\u0435\u0442\u0438\u0442\u044c \"\u041d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c:\" \u0441 \u043a\u0440\u0430\u0442\u043a\u0438\u043c \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435\u043c. \u041d\u043e \u0442\u0430\u043a\u0436\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u043e: \"\u041d\u0435 \u0437\u043b\u043e\u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u044f\u0439 \u044d\u0442\u043e\u0439 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0435\u0439!!!!!!! \u0412\u041d\u0418\u041c\u0410\u0422\u0415\u041b\u042c\u041d\u041e! \u0422\u0423\u0422 \u041b\u041e\u042f\u041b\u042c\u041d\u041e!!!\" \u0422\u043e \u0435\u0441\u0442\u044c \u043d\u0443\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u043b\u043e\u044f\u043b\u044c\u043d\u044b\u043c \u0438 \u043d\u0435 \u043f\u0440\u0438\u0434\u0438\u0440\u0430\u0442\u044c\u0441\u044f \u043a \u043c\u0435\u043b\u043e\u0447\u0430\u043c. \n\n\u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0438\u043c \u043d\u0430 \u043f\u0440\u0438\u043c\u0435\u0440\u044b: \"\u041f\u043e\u043a\u0430\u0436\u0438 \u0442\u043e\u043f-3 \u0441\u0430\u043c\u044b\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043d\u044b\u0445 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0439 \u043f\u043e \u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u044f \u0432 \u044f\u043d\u0432\u0430\u0440\u0435 2025\" - \u043e\u0442\u0432\u0435\u0442 OK, \u0445\u043e\u0442\u044f \u0442\u0430\u043c \u043d\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0438 (\u0441\u0430\u043c\u044b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043d\u044b\u0435 - \u044d\u0442\u043e \u0441\u0430\u043c\u044b\u0435 \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438). \u0412 \u0434\u0430\u043d\u043d\u043e\u043c \u0437\u0430\u043f\u0440\u043e\u0441\u0435 \"Rank schools by their average score in Writing\" - \u043e\u0431\u044b\u0447\u043d\u043e \u0440\u0430\u043d\u0436\u0438\u0440\u0443\u044e\u0442 \u043e\u0442 \u043b\u0443\u0447\u0448\u0435\u0433\u043e \u043a \u0445\u0443\u0434\u0448\u0435\u043c\u0443, \u0442\u043e \u0435\u0441\u0442\u044c \u043f\u043e \u0443\u0431\u044b\u0432\u0430\u043d\u0438\u044e. \u041d\u043e \"score greater than 499\" - \u044d\u0442\u043e \u0432\u044b\u0441\u043e\u043a\u0438\u0435 \u0431\u0430\u043b\u043b\u044b, \u0442\u0430\u043a \u0447\u0442\u043e \u0440\u0430\u043d\u0436\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e \u0443\u0431\u044b\u0432\u0430\u043d\u0438\u044e \u043b\u043e\u0433\u0438\u0447\u043d\u043e. \n\n\u0422\u0430\u043a\u0436\u0435 evidence \u043f\u0440\u043e charter number \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0435\u0439, \u0430 \u043d\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0435\u043c. \n\n\u042f \u0434\u0443\u043c\u0430\u044e, \u0447\u0442\u043e \u0437\u0430\u043f\u0440\u043e\u0441 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u0435\u043d, \u0447\u0442\u043e\u0431\u044b \u0441\u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c SQL. \u041c\u043e\u0436\u043d\u043e \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u044c, \u0447\u0442\u043e \u043d\u0443\u0436\u043d\u043e:\n- SELECT s.cds, s.sname, s.avgscrwrite, sc.charternum, RANK() OVER (ORDER BY s.avgscrwrite DESC) as rank\n- FROM satscores s JOIN schools sc ON s.cds = sc.cdscode\n- WHERE s.avgscrwrite > 499 AND sc.charternum IS NOT NULL (\u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e evidence)\n- ORDER BY rank\n\n\u041d\u043e evidence \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \"Valid charter number means the number is not null\" - \u044d\u0442\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435, \u043d\u043e \u043d\u0435 \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0444\u0438\u043b\u044c\u0442\u0440. \u041e\u0434\u043d\u0430\u043a\u043e, \u0435\u0441\u043b\u0438 \u043c\u044b \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u043c charter numbers, \u0442\u043e null \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043d\u0435 \u0438\u043c\u0435\u044e\u0442 \u0441\u043c\u044b\u0441\u043b\u0430. \u041b\u043e\u0433\u0438\u0447\u043d\u043e \u043e\u0442\u0444\u0438\u043b\u044c\u0442\u0440\u043e\u0432\u0430\u0442\u044c.\n\n\u0422\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u044f \u0441\u0447\u0438\u0442\u0430\u044e, \u0447\u0442\u043e \u0437\u0430\u043f\u0440\u043e\u0441 \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0438\u043d\u044f\u0442\u044c \u043a\u0430\u043a OK, \u0442\u0430\u043a \u043a\u0430\u043a \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u044b \u044f\u0441\u043d\u044b. \n\n\u041e\u0442\u0432\u0435\u0442: OK", "reasoning_details": [{"type": "reasoning.text", "text": "\u041c\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c \u0437\u0430\u043f\u0440\u043e\u0441 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u043d\u0430 \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c. \u0417\u0430\u043f\u0440\u043e\u0441: \"Rank schools by their average score in Writing where the score is greater than 499, showing their charter numbers.\" Evidence: \"Valid charter number means the number is not null\".\n\n\u0421\u043c\u043e\u0442\u0440\u0438\u043c \u043d\u0430 \u0441\u0445\u0435\u043c\u0443: \u0435\u0441\u0442\u044c \u0442\u0430\u0431\u043b\u0438\u0446\u0430 satscores \u0441 \u043f\u043e\u043b\u044f\u043c\u0438 avgscrwrite (BIGINT) - \u044d\u0442\u043e \u0441\u0440\u0435\u0434\u043d\u0438\u0439 \u0431\u0430\u043b\u043b \u043f\u043e \u043f\u0438\u0441\u044c\u043c\u0443. \u0422\u0430\u043a\u0436\u0435 \u0435\u0441\u0442\u044c \u0442\u0430\u0431\u043b\u0438\u0446\u0430 schools \u0441 \u043f\u043e\u043b\u0435\u043c charter (BIGINT) \u0438 charternum (TEXT). \u0412 \u0437\u0430\u043f\u0440\u043e\u0441\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u043e \"charter numbers\" - \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0438\u043c\u0435\u0435\u0442\u0441\u044f \u0432 \u0432\u0438\u0434\u0443 charternum. \u0422\u0430\u043a\u0436\u0435 \u0435\u0441\u0442\u044c \u0443\u0441\u043b\u043e\u0432\u0438\u0435 \"where the score is greater than 499\" - \u044d\u0442\u043e \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f \u043a avgscrwrite. \"Rank schools by their average score in Writing\" - \u043d\u0443\u0436\u043d\u043e \u0440\u0430\u043d\u0436\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0448\u043a\u043e\u043b\u044b \u043f\u043e \u0441\u0440\u0435\u0434\u043d\u0435\u043c\u0443 \u0431\u0430\u043b\u043b\u0443 \u043f\u043e \u043f\u0438\u0441\u044c\u043c\u0443. \u041d\u043e \u0432 \u0442\u0430\u0431\u043b\u0438\u0446\u0435 satscores \u0443\u0436\u0435 \u0435\u0441\u0442\u044c avgscrwrite - \u044d\u0442\u043e \u0441\u0440\u0435\u0434\u043d\u0438\u0439 \u0431\u0430\u043b\u043b \u043f\u043e \u0448\u043a\u043e\u043b\u0435? \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u044d\u0442\u043e \u0443\u0436\u0435 \u0441\u0440\u0435\u0434\u043d\u0435\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435. \u0417\u0430\u043f\u0440\u043e\u0441 \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \"average score in Writing\" - \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c, \u043d\u0443\u0436\u043d\u043e \u0432\u0437\u044f\u0442\u044c \u0441\u0440\u0435\u0434\u043d\u0435\u0435 \u0438\u0437 avgscrwrite? \u041d\u043e avgscrwrite \u0443\u0436\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0441\u0440\u0435\u0434\u043d\u0438\u043c \u0431\u0430\u043b\u043b\u043e\u043c. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0443\u0436\u043d\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u044d\u0442\u043e \u043f\u043e\u043b\u0435. \u0422\u0430\u043a\u0436\u0435 \u043d\u0443\u0436\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c charter numbers. \u0414\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043d\u0443\u0436\u043d\u043e \u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u044c \u0442\u0430\u0431\u043b\u0438\u0446\u044b satscores \u0438 schools \u043f\u043e cds \u0438 cdscode? \u0412 satscores \u0435\u0441\u0442\u044c cds, \u0432 schools \u0435\u0441\u0442\u044c cdscode. \u0412\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u044d\u0442\u043e \u043a\u043b\u044e\u0447.\n\n\u041d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u0438: \n- \"Rank schools\" - \u043a\u0430\u043a \u0440\u0430\u043d\u0436\u0438\u0440\u043e\u0432\u0430\u0442\u044c? \u041f\u043e \u0443\u0431\u044b\u0432\u0430\u043d\u0438\u044e \u0438\u043b\u0438 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u0438\u044e? \u041e\u0431\u044b\u0447\u043d\u043e \u043f\u043e\u0434\u0440\u0430\u0437\u0443\u043c\u0435\u0432\u0430\u0435\u0442\u0441\u044f \u043e\u0442 \u043b\u0443\u0447\u0448\u0435\u0433\u043e \u043a \u0445\u0443\u0434\u0448\u0435\u043c\u0443, \u043d\u043e \u043d\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u043e \u044f\u0432\u043d\u043e. \u041e\u0434\u043d\u0430\u043a\u043e \u0432 SQL \u0440\u0430\u043d\u0436\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u0431\u044b\u0447\u043d\u043e \u043f\u043e\u0434\u0440\u0430\u0437\u0443\u043c\u0435\u0432\u0430\u0435\u0442 ORDER BY, \u0438 \u043c\u043e\u0436\u043d\u043e \u0443\u043a\u0430\u0437\u0430\u0442\u044c DESC. \u041d\u043e \u0437\u0430\u043f\u0440\u043e\u0441 \u043d\u0435 \u0443\u0442\u043e\u0447\u043d\u044f\u0435\u0442 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435. \u042d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c\u044e. \n- \"average score in Writing\" - \u0432 \u0442\u0430\u0431\u043b\u0438\u0446\u0435 \u0435\u0441\u0442\u044c avgscrwrite, \u043d\u043e \u044d\u0442\u043e \u0443\u0436\u0435 \u0441\u0440\u0435\u0434\u043d\u0435\u0435. \u0415\u0441\u043b\u0438 \u043d\u0443\u0436\u043d\u043e \u0440\u0430\u043d\u0436\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u043e \u044d\u0442\u043e\u043c\u0443 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044e, \u0442\u043e \u0432\u0441\u0451 \u043e\u043a. \u041d\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c, \u043d\u0443\u0436\u043d\u043e \u0432\u044b\u0447\u0438\u0441\u043b\u0438\u0442\u044c \u0441\u0440\u0435\u0434\u043d\u0435\u0435 \u043f\u043e \u0432\u0441\u0435\u043c \u0442\u0435\u0441\u0442\u0430\u043c? \u041d\u0435\u0442, \u0441\u043a\u0430\u0437\u0430\u043d\u043e \"their average score in Writing\" - \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u044d\u0442\u043e \u0438 \u0435\u0441\u0442\u044c avgscrwrite.\n- \"where the score is greater than 499\" - score \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f \u043a Writing? \u0414\u0430, \u0441\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e.\n- \"showing their charter numbers\" - \u043d\u0443\u0436\u043d\u043e \u0432\u044b\u0432\u0435\u0441\u0442\u0438 charternum. \u041d\u043e \u0432 evidence \u0441\u043a\u0430\u0437\u0430\u043d\u043e \"Valid charter number means the number is not null\" - \u044d\u0442\u043e \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u0435, \u0447\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0435 null. \u041d\u043e \u0432 \u0437\u0430\u043f\u0440\u043e\u0441\u0435 \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u043e \u0444\u0438\u043b\u044c\u0442\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u043e null, \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0443\u0436\u043d\u043e \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0443\u0441\u043b\u043e\u0432\u0438\u0435, \u0447\u0442\u043e charternum IS NOT NULL? \u041d\u043e evidence \u0433\u043e\u0432\u043e\u0440\u0438\u0442, \u0447\u0442\u043e \u044d\u0442\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435, \u0430 \u043d\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0435. \u041e\u0434\u043d\u0430\u043a\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c: \u043d\u0443\u0436\u043d\u043e \u043b\u0438 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u0448\u043a\u043e\u043b\u044b \u0441 \u0432\u0430\u043b\u0438\u0434\u043d\u044b\u043c charter number? \u0417\u0430\u043f\u0440\u043e\u0441 \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \"showing their charter numbers\" - \u043f\u043e\u0434\u0440\u0430\u0437\u0443\u043c\u0435\u0432\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u0443 \u043a\u0430\u0436\u0434\u043e\u0439 \u0448\u043a\u043e\u043b\u044b \u0435\u0441\u0442\u044c charter number, \u043d\u043e \u0435\u0441\u043b\u0438 \u043e\u043d null, \u0442\u043e \u0447\u0442\u043e \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c? \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0443\u0436\u043d\u043e \u043e\u0442\u0444\u0438\u043b\u044c\u0442\u0440\u043e\u0432\u0430\u0442\u044c. \u041d\u043e evidence \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \"Valid charter number means the number is not null\" - \u044d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u043e\u0439, \u0447\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u043d\u0435 null. \u041d\u043e \u0432 \u0441\u0430\u043c\u043e\u043c \u0437\u0430\u043f\u0440\u043e\u0441\u0435 \u043d\u0435\u0442 \u044f\u0432\u043d\u043e\u0433\u043e \u0444\u0438\u043b\u044c\u0442\u0440\u0430. \u042d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c\u044e.\n\n\u0422\u0430\u043a\u0436\u0435 \u043d\u0443\u0436\u043d\u043e \u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u044c \u0442\u0430\u0431\u043b\u0438\u0446\u044b. \u0412 \u0437\u0430\u043f\u0440\u043e\u0441\u0435 \u043d\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u043e, \u043a\u0430\u043a \u0441\u043e\u0435\u0434\u0438\u043d\u044f\u0442\u044c. \u041d\u043e \u043f\u043e \u0441\u0445\u0435\u043c\u0435 \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u044c, \u0447\u0442\u043e cds \u0432 satscores \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 cdscode \u0432 schools. \u042d\u0442\u043e \u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e.\n\n\u0415\u0449\u0451: \"Rank schools\" - \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0443\u0436\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043e\u043a\u043e\u043d\u043d\u0443\u044e \u0444\u0443\u043d\u043a\u0446\u0438\u044e RANK() \u0438\u043b\u0438 \u043f\u0440\u043e\u0441\u0442\u043e ORDER BY? \u041e\u0431\u044b\u0447\u043d\u043e \"rank\" \u043f\u043e\u0434\u0440\u0430\u0437\u0443\u043c\u0435\u0432\u0430\u0435\u0442 \u043f\u0440\u0438\u0441\u0432\u043e\u0435\u043d\u0438\u0435 \u0440\u0430\u043d\u0433\u0430. \u041d\u043e \u0432 SQL \u043c\u043e\u0436\u043d\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c RANK() OVER (ORDER BY avgscrwrite DESC). \u041d\u043e \u0435\u0441\u043b\u0438 \u043f\u0440\u043e\u0441\u0442\u043e ORDER BY, \u0442\u043e \u044d\u0442\u043e \u0441\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0430, \u0430 \u043d\u0435 \u0440\u0430\u043d\u0436\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0441 \u043d\u043e\u043c\u0435\u0440\u0430\u043c\u0438. \u0417\u0430\u043f\u0440\u043e\u0441 \u043d\u0435 \u0443\u0442\u043e\u0447\u043d\u044f\u0435\u0442, \u043d\u0443\u0436\u043d\u043e \u043b\u0438 \u0432\u044b\u0432\u043e\u0434\u0438\u0442\u044c \u043d\u043e\u043c\u0435\u0440 \u0440\u0430\u043d\u0433\u0430. \u042d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c\u044e.\n\n\u0412 \u0446\u0435\u043b\u043e\u043c, \u0435\u0441\u0442\u044c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u0435\u0439: \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0440\u0430\u043d\u0436\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f, \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u044c \u0444\u0438\u043b\u044c\u0442\u0440\u0430 \u043f\u043e null charter number, \u0438 \u043d\u0443\u0436\u043d\u043e \u043b\u0438 \u0432\u044b\u0432\u043e\u0434\u0438\u0442\u044c \u0440\u0430\u043d\u0433 \u0438\u043b\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u0441\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c. \u041e\u0434\u043d\u0430\u043a\u043e, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0432 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0435 \u0437\u0430\u0434\u0430\u0447\u0438 \"Rank schools\" \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u0442\u0441\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u043e \u0443\u0431\u044b\u0432\u0430\u043d\u0438\u044e. \u041d\u043e \u043b\u0443\u0447\u0448\u0435 \u0443\u0442\u043e\u0447\u043d\u0438\u0442\u044c.\n\n\u0421\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438, \u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c, \u043d\u0443\u0436\u043d\u043e \u043e\u0442\u0432\u0435\u0442\u0438\u0442\u044c \"\u041d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c:\" \u0441 \u043a\u0440\u0430\u0442\u043a\u0438\u043c \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u0435\u043c. \u041d\u043e \u0442\u0430\u043a\u0436\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u043e: \"\u041d\u0435 \u0437\u043b\u043e\u0443\u043f\u043e\u0442\u0440\u0435\u0431\u043b\u044f\u0439 \u044d\u0442\u043e\u0439 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0430\u0446\u0438\u0435\u0439!!!!!!! \u0412\u041d\u0418\u041c\u0410\u0422\u0415\u041b\u042c\u041d\u041e! \u0422\u0423\u0422 \u041b\u041e\u042f\u041b\u042c\u041d\u041e!!!\" \u0422\u043e \u0435\u0441\u0442\u044c \u043d\u0443\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u043b\u043e\u044f\u043b\u044c\u043d\u044b\u043c \u0438 \u043d\u0435 \u043f\u0440\u0438\u0434\u0438\u0440\u0430\u0442\u044c\u0441\u044f \u043a \u043c\u0435\u043b\u043e\u0447\u0430\u043c. \n\n\u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0438\u043c \u043d\u0430 \u043f\u0440\u0438\u043c\u0435\u0440\u044b: \"\u041f\u043e\u043a\u0430\u0436\u0438 \u0442\u043e\u043f-3 \u0441\u0430\u043c\u044b\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043d\u044b\u0445 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0439 \u043f\u043e \u0441\u0440\u0435\u0434\u043d\u0435\u0439 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u044f \u0432 \u044f\u043d\u0432\u0430\u0440\u0435 2025\" - \u043e\u0442\u0432\u0435\u0442 OK, \u0445\u043e\u0442\u044f \u0442\u0430\u043c \u043d\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u043e \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u043a\u0438 (\u0441\u0430\u043c\u044b\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043d\u044b\u0435 - \u044d\u0442\u043e \u0441\u0430\u043c\u044b\u0435 \u0431\u043e\u043b\u044c\u0448\u0438\u0435 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438). \u0412 \u0434\u0430\u043d\u043d\u043e\u043c \u0437\u0430\u043f\u0440\u043e\u0441\u0435 \"Rank schools by their average score in Writing\" - \u043e\u0431\u044b\u0447\u043d\u043e \u0440\u0430\u043d\u0436\u0438\u0440\u0443\u044e\u0442 \u043e\u0442 \u043b\u0443\u0447\u0448\u0435\u0433\u043e \u043a \u0445\u0443\u0434\u0448\u0435\u043c\u0443, \u0442\u043e \u0435\u0441\u0442\u044c \u043f\u043e \u0443\u0431\u044b\u0432\u0430\u043d\u0438\u044e. \u041d\u043e \"score greater than 499\" - \u044d\u0442\u043e \u0432\u044b\u0441\u043e\u043a\u0438\u0435 \u0431\u0430\u043b\u043b\u044b, \u0442\u0430\u043a \u0447\u0442\u043e \u0440\u0430\u043d\u0436\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e \u0443\u0431\u044b\u0432\u0430\u043d\u0438\u044e \u043b\u043e\u0433\u0438\u0447\u043d\u043e. \n\n\u0422\u0430\u043a\u0436\u0435 evidence \u043f\u0440\u043e charter number \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0435\u0439, \u0430 \u043d\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0435\u043c. \n\n\u042f \u0434\u0443\u043c\u0430\u044e, \u0447\u0442\u043e \u0437\u0430\u043f\u0440\u043e\u0441 \u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u0435\u043d, \u0447\u0442\u043e\u0431\u044b \u0441\u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c SQL. \u041c\u043e\u0436\u043d\u043e \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u043e\u0436\u0438\u0442\u044c, \u0447\u0442\u043e \u043d\u0443\u0436\u043d\u043e:\n- SELECT s.cds, s.sname, s.avgscrwrite, sc.charternum, RANK() OVER (ORDER BY s.avgscrwrite DESC) as rank\n- FROM satscores s JOIN schools sc ON s.cds = sc.cdscode\n- WHERE s.avgscrwrite > 499 AND sc.charternum IS NOT NULL (\u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e evidence)\n- ORDER BY rank\n\n\u041d\u043e evidence \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \"Valid charter number means the number is not null\" - \u044d\u0442\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435, \u043d\u043e \u043d\u0435 \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0444\u0438\u043b\u044c\u0442\u0440. \u041e\u0434\u043d\u0430\u043a\u043e, \u0435\u0441\u043b\u0438 \u043c\u044b \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u043c charter numbers, \u0442\u043e null \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043d\u0435 \u0438\u043c\u0435\u044e\u0442 \u0441\