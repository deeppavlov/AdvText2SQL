2\u043e\u0440\u043e\u043c \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043a\u0430\u0440\u0442\u0430 \u0441 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\u043c 'Tendo Ice Bridge'?\".\n\n\u0412 \u0441\u0445\u0435\u043c\u0435 \u0435\u0441\u0442\u044c \u0442\u0430\u0431\u043b\u0438\u0446\u044b: sets (\u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 name, code \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043f\u043e\u043b\u044f), set_translations (\u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 setcode, language, translation), foreign_data (\u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 name, language, uuid \u0438 \u0442.\u0434.), cards (\u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 name, setcode, uuid \u0438 \u0442.\u0434.). \n\n\u041a\u0430\u0440\u0442\u0430 \"Tendo Ice Bridge\" - \u044d\u0442\u043e, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0438\u043c\u044f \u043a\u0430\u0440\u0442\u044b. \u0412 cards \u0435\u0441\u0442\u044c \u043f\u043e\u043b\u0435 name. \u0422\u0430\u043a\u0436\u0435 \u0435\u0441\u0442\u044c foreign_data, \u0433\u0434\u0435 \u0445\u0440\u0430\u043d\u044f\u0442\u0441\u044f \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u044b \u043a\u0430\u0440\u0442? \u0412 foreign_data \u0435\u0441\u0442\u044c name, language, flavortext, text, type, uuid. \u041d\u043e foreign_data \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 flavortext \u0438 text \u043d\u0430 \u0440\u0430\u0437\u043d\u044b\u0445 \u044f\u0437\u044b\u043a\u0430\u0445? \u0421\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430: foreign_data - \u044d\u0442\u043e \u0442\u0430\u0431\u043b\u0438\u0446\u0430 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u043e\u0432 \u043a\u0430\u0440\u0442? \u0412 \u043d\u0435\u0439 \u0435\u0441\u0442\u044c name (\u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043a\u0430\u0440\u0442\u044b \u043d\u0430 \u0434\u0440\u0443\u0433\u043e\u043c \u044f\u0437\u044b\u043a\u0435?), language, uuid (\u0441\u0432\u044f\u0437\u044c \u0441 cards.uuid). \u0418 \u0435\u0441\u0442\u044c set_translations - \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u044b \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0439 \u0441\u0435\u0442\u043e\u0432.\n\n\u0417\u0430\u043f\u0440\u043e\u0441: \"French name of the set of cards with 'Tendo Ice Bridge' is in\". \u0422\u043e \u0435\u0441\u0442\u044c \u043d\u0443\u0436\u043d\u043e \u043d\u0430\u0439\u0442\u0438 \u0441\u0435\u0442, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044f \u043a\u0430\u0440\u0442\u0430 \u0441 \u0438\u043c\u0435\u043d\u0435\u043c \"Tendo Ice Bridge\", \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u044d\u0442\u043e\u0433\u043e \u0441\u0435\u0442\u0430.\n\n\u041f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u0438:\n- \u041a\u0430\u043a \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c, \u0432 \u043a\u0430\u043a\u043e\u043c \u0441\u0435\u0442\u0435 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043a\u0430\u0440\u0442\u0430? \u0412 cards \u0435\u0441\u0442\u044c \u043f\u043e\u043b\u0435 setcode, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0441\u0441\u044b\u043b\u0430\u0435\u0442\u0441\u044f \u043d\u0430 sets.code. \u042d\u0442\u043e \u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e.\n- \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043a\u0430\u0440\u0442\u044b. \u041e\u043d\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043d\u0430 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u043c? \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u044d\u0442\u043e \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0435 \u0438\u043c\u044f \u043a\u0430\u0440\u0442\u044b. \u0412 foreign_data \u0435\u0441\u0442\u044c name \u043d\u0430 \u0434\u0440\u0443\u0433\u0438\u0445 \u044f\u0437\u044b\u043a\u0430\u0445. \u041d\u043e \u0432 \u0437\u0430\u043f\u0440\u043e\u0441\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u043e \"Tendo Ice Bridge\" \u0431\u0435\u0437 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u044f\u0437\u044b\u043a\u0430. \u0421\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e, \u044d\u0442\u043e \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0435 \u0438\u043c\u044f, \u0442\u0430\u043a \u043a\u0430\u043a \u043a\u0430\u0440\u0442\u044b \u043e\u0431\u044b\u0447\u043d\u043e \u0438\u043c\u0435\u044e\u0442 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438\u0435 \u0438\u043c\u0435\u043d\u0430. \u041d\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0438 \u0438\u043c\u044f \u043d\u0430 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u043c? \"Tendo Ice Bridge\" \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u043a\u0430\u043a \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0435. \u0412 \u0442\u0430\u0431\u043b\u0438\u0446\u0435 cards \u0435\u0441\u0442\u044c name (\u043d\u0430 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u043c). \u0412 foreign_data \u0435\u0441\u0442\u044c name (\u043d\u0430 \u0434\u0440\u0443\u0433\u0438\u0445 \u044f\u0437\u044b\u043a\u0430\u0445). \u0415\u0441\u043b\u0438 \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0435 \u0438\u043c\u044f, \u0442\u043e \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u0439\u0442\u0438 card.uuid \u043f\u043e cards.name = 'Tendo Ice Bridge', \u0437\u0430\u0442\u0435\u043c \u043f\u043e cards.setcode \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c sets.code, \u0437\u0430\u0442\u0435\u043c \u043f\u043e set_translations \u0433\u0434\u0435 setcode = sets.code \u0438 language = 'French' \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c translation. \u041d\u043e \u0435\u0441\u0442\u044c \u043b\u0438 \u0432 foreign_data \u043f\u043e\u043b\u0435 \u0434\u043b\u044f \u0438\u043c\u0435\u043d\u0438 \u0441\u0435\u0442\u0430? \u041d\u0435\u0442, foreign_data \u0434\u043b\u044f \u043a\u0430\u0440\u0442. \u0415\u0441\u0442\u044c set_translations \u0434\u043b\u044f \u0441\u0435\u0442\u043e\u0432.\n\n\u0422\u0430\u043a\u0436\u0435 \u0435\u0441\u0442\u044c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c, \u0447\u0442\u043e \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u043d\u043e\u0435 \u0438\u043c\u044f (French name of the card)? \u041d\u043e \u0437\u0430\u043f\u0440\u043e\u0441 \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \"French name of the set\", \u0430 \u043d\u0435 \u043a\u0430\u0440\u0442\u044b. \u0422\u043e \u0435\u0441\u0442\u044c \u043d\u0443\u0436\u043d\u043e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u0438\u043c\u044f \u0441\u0435\u0442\u0430.\n\n\u041e\u0434\u043d\u0430\u043a\u043e \u0435\u0441\u0442\u044c \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c: \"sets of cards with 'Tendo Ice Bridge' is in\" - \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0438\u043c\u0435\u0435\u0442\u0441\u044f \u0432 \u0432\u0438\u0434\u0443 \u0441\u0435\u0442, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0435\u0441\u0442\u044c \u044d\u0442\u0430 \u043a\u0430\u0440\u0442\u0430. \u041d\u043e \u043a\u0430\u0440\u0442\u044b \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u0441\u0435\u0442\u0430\u0445? \u0412 cards \u0435\u0441\u0442\u044c \u043f\u043e\u043b\u0435 setcode, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043d\u0430 \u043e\u0434\u0438\u043d \u0441\u0435\u0442. \u0423 \u043a\u0430\u0440\u0442\u044b \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u0435\u0447\u0430\u0442\u0435\u0439? \u0412 \u0442\u0430\u0431\u043b\u0438\u0446\u0435 cards, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u043a\u0430\u0436\u0434\u0430\u044f \u0437\u0430\u043f\u0438\u0441\u044c - \u044d\u0442\u043e \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0435 \u0438\u0437\u0434\u0430\u043d\u0438\u0435 \u043a\u0430\u0440\u0442\u044b (\u0441 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c uuid). \u0422\u043e \u0435\u0441\u0442\u044c \u043e\u0434\u043d\u0430 \u043a\u0430\u0440\u0442\u0430 \u043c\u043e\u0436\u0435\u0442 \u0438\u043c\u0435\u0442\u044c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u043f\u0438\u0441\u0435\u0439 \u0441 \u0440\u0430\u0437\u043d\u044b\u043c\u0438 setcode. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043a\u0430\u0440\u0442\u0430 \"Tendo Ice Bridge\" \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043f\u0435\u0440\u0435\u0438\u0437\u0434\u0430\u043d\u0430 \u0432 \u0440\u0430\u0437\u043d\u044b\u0445 \u0441\u0435\u0442\u0430\u0445. \u0422\u043e\u0433\u0434\u0430 \u043a\u0430\u043a\u043e\u0439 \u0441\u0435\u0442 \u0438\u043c\u0435\u0435\u0442\u0441\u044f \u0432 \u0432\u0438\u0434\u0443? \u0417\u0430\u043f\u0440\u043e\u0441 \u043d\u0435 \u0443\u0442\u043e\u0447\u043d\u044f\u0435\u0442, \u0432 \u043a\u0430\u043a\u043e\u043c \u0438\u043c\u0435\u043d\u043d\u043e \u0441\u0435\u0442\u0435 - \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043f\u043e\u0434\u0440\u0430\u0437\u0443\u043c\u0435\u0432\u0430\u0435\u0442\u0441\u044f \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u0435\u0442? \u041d\u043e \u0432 \u0434\u0430\u043d\u043d\u044b\u0445 \u043d\u0435\u0442 \u044f\u0432\u043d\u043e\u0433\u043e \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043d\u0430 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u0435\u0442. \u041c\u043e\u0436\u043d\u043e \u0432\u0437\u044f\u0442\u044c \u0432\u0441\u0435 \u0441\u0435\u0442\u044b, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0435\u0441\u0442\u044c \u044d\u0442\u0430 \u043a\u0430\u0440\u0442\u0430, \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0438\u0445 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f. \u041d\u043e \u0437\u0430\u043f\u0440\u043e\u0441 \u0432 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \"the set\" - \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u0435\u0442\u0441\u044f \u043e\u0434\u0438\u043d \u0441\u0435\u0442. \u042d\u0442\u043e \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c, \u0435\u0441\u043b\u0438 \u043a\u0430\u0440\u0442\u0430 \u0435\u0441\u0442\u044c \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u0441\u0435\u0442\u0430\u0445. \u041d\u043e \u0432 MTG \u043a\u0430\u0436\u0434\u0430\u044f \u043a\u0430\u0440\u0442\u0430 \u0438\u043c\u0435\u0435\u0442 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u0438\u043c\u044f, \u0438 \u0447\u0430\u0441\u0442\u043e \u0432\u044b\u043f\u0443\u0441\u043a\u0430\u0435\u0442\u0441\u044f \u0432 \u043e\u0434\u043d\u043e\u043c \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c \u0441\u0435\u0442\u0435, \u043d\u043e \u0431\u044b\u0432\u0430\u044e\u0442 \u043f\u0435\u0440\u0435\u0438\u0437\u0434\u0430\u043d\u0438\u044f. \u041f\u043e\u044d\u0442\u043e\u043c\u0443 \u043d\u0443\u0436\u043d\u043e \u0443\u0442\u043e\u0447\u043d\u0438\u0442\u044c, \u043a\u0430\u043a\u043e\u0439 \u0441\u0435\u0442 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442.\n\n\u0422\u0430\u043a\u0436\u0435 \u0435\u0441\u0442\u044c foreign_data, \u0433\u0434\u0435 \u0445\u0440\u0430\u043d\u044f\u0442\u0441\u044f \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u044b \u043a\u0430\u0440\u0442. \u041c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c, \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u0438\u043c\u044f \u043a\u0430\u0440\u0442\u044b? \u041d\u043e \u0437\u0430\u043f\u0440\u043e\u0441 \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \"French name of the set\", \u0442\u0430\u043a \u0447\u0442\u043e \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e \u043a\u0430\u0440\u0442\u0443.\n\n\u0415\u0441\u0442\u044c evidence: \"French refers to language = 'French'; \"Tendo Ice Bridge\" is a translated name of a card; translated name refers to translation\" \u042d\u0442\u043e evidence \u0443\u0442\u043e\u0447\u043d\u044f\u0435\u0442, \u0447\u0442\u043e French - \u044d\u0442\u043e \u044f\u0437\u044b\u043a French, \u0438 \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u043d\u043e\u0435 \u0438\u043c\u044f \u043a\u0430\u0440\u0442\u044b (\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0430 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u043c?). \u0422\u043e \u0435\u0441\u0442\u044c evidence \u0433\u043e\u0432\u043e\u0440\u0438\u0442, \u0447\u0442\u043e \"Tendo Ice Bridge\" \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u043e\u043c \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f \u043a\u0430\u0440\u0442\u044b (translated name). \u0422\u043e\u0433\u0434\u0430 \u044d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u0438\u043c\u044f \u043a\u0430\u0440\u0442\u044b? \u0418\u043b\u0438 \u043d\u0430\u043e\u0431\u043e\u0440\u043e\u0442? \"translated name refers to translation\" - \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0447\u0442\u043e \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u043d\u0430 \u043a\u0430\u043a\u043e\u0439-\u0442\u043e \u044f\u0437\u044b\u043a. \u041d\u043e evidence \u043d\u0435 \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u0447\u0442\u043e \u044d\u0442\u043e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439. \u041e\u043d\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442, \u0447\u0442\u043e French - \u044d\u0442\u043e \u044f\u0437\u044b\u043a, \u0438 \u0447\u0442\u043e \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u043d\u043e\u0435 \u0438\u043c\u044f. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u044d\u0442\u043e \u0438\u043c\u044f \u043d\u0430 \u0434\u0440\u0443\u0433\u043e\u043c \u044f\u0437\u044b\u043a\u0435, \u0430 \u043c\u044b \u0438\u0449\u0435\u043c \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0441\u0435\u0442\u0430. \u0412 \u043b\u044e\u0431\u043e\u043c \u0441\u043b\u0443\u0447\u0430\u0435, \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c: \u0435\u0441\u043b\u0438 \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u043d\u043e\u0435 \u0438\u043c\u044f (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043d\u0430 \u044f\u043f\u043e\u043d\u0441\u043a\u0438\u0439), \u0442\u043e \u043a\u0430\u043a \u043d\u0430\u0439\u0442\u0438 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0443\u044e \u043a\u0430\u0440\u0442\u0443? \u041d\u0443\u0436\u043d\u043e \u043d\u0430\u0439\u0442\u0438 \u0432 foreign_data \u0437\u0430\u043f\u0438\u0441\u044c \u0441 name = 'Tendo Ice Bridge' \u0438 language = ? \u041d\u043e \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u043e, \u043d\u0430 \u043a\u0430\u043a\u043e\u043c \u044f\u0437\u044b\u043a\u0435 \u044d\u0442\u043e \u0438\u043c\u044f. \u041c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c, \u044d\u0442\u043e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u0438\u043c\u044f? \u041d\u043e evidence \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \"French refers to language = 'French'\", \u043d\u043e \u043d\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u0442, \u0447\u0442\u043e \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u0438\u043c\u044f. \u041e\u043d\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \"Tendo Ice Bridge\" is a translated name of a card\", \u0442\u043e \u0435\u0441\u0442\u044c \u044d\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u043d\u043e\u0435 \u0438\u043c\u044f, \u043d\u043e \u044f\u0437\u044b\u043a \u043d\u0435 \u0443\u043a\u0430\u0437\u0430\u043d. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u044d\u0442\u043e \u0438\u043c\u044f \u043d\u0430 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u043c? \"translated name\" \u043c\u043e\u0436\u0435\u0442 \u043e\u0437\u043d\u0430\u0447\u0430\u0442\u044c, \u0447\u0442\u043e \u044d\u0442\u043e \u0438\u043c\u044f - \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u0441 \u0434\u0440\u0443\u0433\u043e\u0433\u043e \u044f\u0437\u044b\u043a\u0430. \u041d\u043e \u0442\u043e\u0433\u0434\u0430 \u043d\u0435\u044f\u0441\u043d\u043e, \u043a\u0430\u043a \u043d\u0430\u0439\u0442\u0438 \u043a\u0430\u0440\u0442\u0443.\n\n\u0420\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0438\u043c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u043f\u0440\u0435\u0442\u0430\u0446\u0438\u0438:\n1) \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0435 \u0438\u043c\u044f \u043a\u0430\u0440\u0442\u044b (\u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b). \u0422\u043e\u0433\u0434\u0430 \u043c\u044b \u0438\u0449\u0435\u043c \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0441\u0435\u0442\u0430, \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0435\u0433\u043e \u044d\u0442\u0443 \u043a\u0430\u0440\u0442\u0443.\n2) \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u0438\u043c\u044f \u043a\u0430\u0440\u0442\u044b (\u043f\u0435\u0440\u0435\u0432\u043e\u0434). \u0422\u043e\u0433\u0434\u0430 \u043c\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u043d\u0430\u0439\u0442\u0438 \u043a\u0430\u0440\u0442\u0443 \u0441 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u043c \u0438\u043c\u0435\u043d\u0435\u043c, \u0437\u0430\u0442\u0435\u043c \u043d\u0430\u0439\u0442\u0438 \u0441\u0435\u0442, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043e\u043d\u0430 \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044f, \u0438 \u0432\u044b\u0432\u0435\u0441\u0442\u0438 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0441\u0435\u0442\u0430.\n\u0412 evidence \u0441\u043a\u0430\u0437\u0430\u043d\u043e, \u0447\u0442\u043e \"Tendo Ice Bridge\" is a translated name of a card, \u0447\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u043d\u0430 \u0442\u043e, \u0447\u0442\u043e \u044d\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u043e\u0434, \u0430 \u043d\u0435 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b. \u041d\u043e \u043a\u0430\u043a\u043e\u0439 \u044f\u0437\u044b\u043a? \u041d\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u043e. \u042d\u0442\u043e \u0441\u043e\u0437\u0434\u0430\u0435\u0442 \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c.\n\n\u0422\u0430\u043a\u0436\u0435 evidence: \"translated name refers to translation\" - \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0435 \u043d\u0430 \u0441\u0432\u044f\u0437\u044c \u0441 \u0442\u0430\u0431\u043b\u0438\u0446\u0435\u0439 set_translations, \u0433\u0434\u0435 translation - \u044d\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u043d\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0441\u0435\u0442\u0430. \u041d\u043e \u0432 evidence \u043d\u0435\u043f\u043e\u043d\u044f\u0442\u043d\u043e.\n\n\u0423\u0447\u0438\u0442\u044b\u0432\u0430\u044f, \u0447\u0442\u043e \u0432 \u0441\u0445\u0435\u043c\u0435 \u0435\u0441\u0442\u044c foreign_data \u0441 \u043f\u043e\u043b\u044f\u043c\u0438 name, language, uuid. \u0415\u0441\u043b\u0438 \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u0438\u043c\u044f \u043a\u0430\u0440\u0442\u044b \u043d\u0430 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u043c \u044f\u0437\u044b\u043a\u0435, \u0442\u043e \u043c\u044b \u043c\u043e\u0436\u0435\u043c \u043d\u0430\u0439\u0442\u0438 uuid \u043a\u0430\u0440\u0442\u044b \u0432 foreign_data, \u0433\u0434\u0435 name = 'Tendo Ice Bridge'. \u0417\u0430\u0442\u0435\u043c \u043f\u043e cards.uuid = foreign_data.uuid \u043d\u0430\u0439\u0442\u0438 setcode. \u0418\u043b\u0438 \u043d\u0430\u043e\u0431\u043e\u0440\u043e\u0442, \u0435\u0441\u043b\u0438 \u044d\u0442\u043e \u0438\u043c\u044f \u043d\u0430 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u043c, \u0442\u043e \u0432 cards.name.\n\n\u041d\u043e evidence \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \"translated name of a card\", \u0447\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u043e\u0437\u043d\u0430\u0447\u0430\u0442\u044c, \u0447\u0442\u043e \u044d\u0442\u043e \u0438\u043c\u044f \u0445\u0440\u0430\u043d\u0438\u0442\u0441\u044f \u0432 foreign_data (\u043f\u0435\u0440\u0435\u0432\u043e\u0434\u044b). \u041e\u0434\u043d\u0430\u043a\u043e language \u043d\u0435 \u0443\u043a\u0430\u0437\u0430\u043d. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043f\u043e\u0434\u0440\u0430\u0437\u0443\u043c\u0435\u0432\u0430\u0435\u0442\u0441\u044f, \u0447\u0442\u043e \u044d\u0442\u043e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u0438\u043c\u044f? \u0422\u043e\u0433\u0434\u0430 \u043c\u044b \u0438\u0449\u0435\u043c \u043a\u0430\u0440\u0442\u0443 \u0441 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u043c \u0438\u043c\u0435\u043d\u0435\u043c, \u0437\u0430\u0442\u0435\u043c \u0441\u0435\u0442, \u0438 \u0437\u0430\u0442\u0435\u043c \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0441\u0435\u0442\u0430. \u041d\u043e \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u0431\u044b \u0441\u0442\u0440\u0430\u043d\u043d\u043e: \u0438\u0449\u0435\u043c \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u0438\u043c\u044f \u0441\u0435\u0442\u0430, \u043a\u043e\u0433\u0434\u0430 \u0441\u0430\u043c\u0430 \u043a\u0430\u0440\u0442\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430 \u043f\u043e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u043c\u0443 \u0438\u043c\u0435\u043d\u0438. \u0412\u043f\u043e\u043b\u043d\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e.\n\n\u0411\u0435\u0437 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u0439 \u0437\u0430\u043f\u0440\u043e\u0441 \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u0435\u043d, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043d\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u043e, \u043d\u0430 \u043a\u0430\u043a\u043e\u043c \u044f\u0437\u044b\u043a\u0435 \u0434\u0430\u043d\u043e \u0438\u043c\u044f \"Tendo Ice Bridge\", \u0438 \u043a\u0430\u043a\u043e\u0439 \u0438\u043c\u0435\u043d\u043d\u043e \u0441\u0435\u0442 \u0438\u043c\u0435\u0435\u0442\u0441\u044f \u0432 \u0432\u0438\u0434\u0443 (\u0435\u0441\u043b\u0438 \u043a\u0430\u0440\u0442\u0430 \u0435\u0441\u0442\u044c \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u0441\u0435\u0442\u0430\u0445). \u041a\u0440\u043e\u043c\u0435 \u0442\u043e\u0433\u043e, evidence \u043d\u0435 \u0441\u043d\u0438\u043c\u0430\u0435\u0442 \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c, \u0430 \u0441\u043a\u043e\u0440\u0435\u0435 \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u0435\u0435.\n\n\u041f\u043e\u044d\u0442\u043e\u043c\u0443 \u043e\u0442\u0432\u0435\u0442: \u041d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c: \u043d\u0435 \u0443\u043a\u0430\u0437\u0430\u043d \u044f\u0437\u044b\u043a \u0438\u043c\u0435\u043d\u0438 \u043a\u0430\u0440\u0442\u044b \"Tendo Ice Bridge\" (\u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b \u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u0432\u043e\u0434), \u0430 \u0442\u0430\u043a\u0436\u0435 \u043d\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u043e, \u043a\u0430\u043a\u043e\u0439 \u0438\u043c\u0435\u043d\u043d\u043e \u0441\u0435\u0442 \u0438\u043c\u0435\u0435\u0442\u0441\u044f \u0432 \u0432\u0438\u0434\u0443, \u0435\u0441\u043b\u0438 \u043a\u0430\u0440\u0442\u0430 \u0435\u0441\u0442\u044c \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u0441\u0435\u0442\u0430\u0445.", "reasoning_details": [{"type": "reasoning.text", "text": "\u041c\u044b \u0434\u043e\u043b\u0436\u043d\u044b \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0437\u0430\u043f\u0440\u043e\u0441 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f: \"What's the French name of the set of cards with \"Tendo Ice Bridge\" is in?\".\n\n\u0417\u0430\u043f\u0440\u043e\u0441 \u0441\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442: \"\u041a\u0430\u043a\u043e\u0435 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0441\u0435\u0442\u0430, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043a\u0430\u0440\u0442\u0430 \u0441 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435\u043c 'Tendo Ice Bridge'?\".\n\n\u0412 \u0441\u0445\u0435\u043c\u0435 \u0435\u0441\u0442\u044c \u0442\u0430\u0431\u043b\u0438\u0446\u044b: sets (\u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 name, code \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043f\u043e\u043b\u044f), set_translations (\u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 setcode, language, translation), foreign_data (\u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 name, language, uuid \u0438 \u0442.\u0434.), cards (\u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 name, setcode, uuid \u0438 \u0442.\u0434.). \n\n\u041a\u0430\u0440\u0442\u0430 \"Tendo Ice Bridge\" - \u044d\u0442\u043e, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u0438\u043c\u044f \u043a\u0430\u0440\u0442\u044b. \u0412 cards \u0435\u0441\u0442\u044c \u043f\u043e\u043b\u0435 name. \u0422\u0430\u043a\u0436\u0435 \u0435\u0441\u0442\u044c foreign_data, \u0433\u0434\u0435 \u0445\u0440\u0430\u043d\u044f\u0442\u0441\u044f \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u044b \u043a\u0430\u0440\u0442? \u0412 foreign_data \u0435\u0441\u0442\u044c name, language, flavortext, text, type, uuid. \u041d\u043e foreign_data \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 flavortext \u0438 text \u043d\u0430 \u0440\u0430\u0437\u043d\u044b\u0445 \u044f\u0437\u044b\u043a\u0430\u0445? \u0421\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430: foreign_data - \u044d\u0442\u043e \u0442\u0430\u0431\u043b\u0438\u0446\u0430 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u043e\u0432 \u043a\u0430\u0440\u0442? \u0412 \u043d\u0435\u0439 \u0435\u0441\u0442\u044c name (\u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043a\u0430\u0440\u0442\u044b \u043d\u0430 \u0434\u0440\u0443\u0433\u043e\u043c \u044f\u0437\u044b\u043a\u0435?), language, uuid (\u0441\u0432\u044f\u0437\u044c \u0441 cards.uuid). \u0418 \u0435\u0441\u0442\u044c set_translations - \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u044b \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0439 \u0441\u0435\u0442\u043e\u0432.\n\n\u0417\u0430\u043f\u0440\u043e\u0441: \"French name of the set of cards with 'Tendo Ice Bridge' is in\". \u0422\u043e \u0435\u0441\u0442\u044c \u043d\u0443\u0436\u043d\u043e \u043d\u0430\u0439\u0442\u0438 \u0441\u0435\u0442, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044f \u043a\u0430\u0440\u0442\u0430 \u0441 \u0438\u043c\u0435\u043d\u0435\u043c \"Tendo Ice Bridge\", \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u044d\u0442\u043e\u0433\u043e \u0441\u0435\u0442\u0430.\n\n\u041f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u0438:\n- \u041a\u0430\u043a \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c, \u0432 \u043a\u0430\u043a\u043e\u043c \u0441\u0435\u0442\u0435 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043a\u0430\u0440\u0442\u0430? \u0412 cards \u0435\u0441\u0442\u044c \u043f\u043e\u043b\u0435 setcode, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0441\u0441\u044b\u043b\u0430\u0435\u0442\u0441\u044f \u043d\u0430 sets.code. \u042d\u0442\u043e \u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e.\n- \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043a\u0430\u0440\u0442\u044b. \u041e\u043d\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043d\u0430 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u043c? \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u044d\u0442\u043e \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0435 \u0438\u043c\u044f \u043a\u0430\u0440\u0442\u044b. \u0412 foreign_data \u0435\u0441\u0442\u044c name \u043d\u0430 \u0434\u0440\u0443\u0433\u0438\u0445 \u044f\u0437\u044b\u043a\u0430\u0445. \u041d\u043e \u0432 \u0437\u0430\u043f\u0440\u043e\u0441\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u043e \"Tendo Ice Bridge\" \u0431\u0435\u0437 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u044f\u0437\u044b\u043a\u0430. \u0421\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e, \u044d\u0442\u043e \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0435 \u0438\u043c\u044f, \u0442\u0430\u043a \u043a\u0430\u043a \u043a\u0430\u0440\u0442\u044b \u043e\u0431\u044b\u0447\u043d\u043e \u0438\u043c\u0435\u044e\u0442 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438\u0435 \u0438\u043c\u0435\u043d\u0430. \u041d\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0438 \u0438\u043c\u044f \u043d\u0430 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u043c? \"Tendo Ice Bridge\" \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u043a\u0430\u043a \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0435. \u0412 \u0442\u0430\u0431\u043b\u0438\u0446\u0435 cards \u0435\u0441\u0442\u044c name (\u043d\u0430 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u043c). \u0412 foreign_data \u0435\u0441\u0442\u044c name (\u043d\u0430 \u0434\u0440\u0443\u0433\u0438\u0445 \u044f\u0437\u044b\u043a\u0430\u0445). \u0415\u0441\u043b\u0438 \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0435 \u0438\u043c\u044f, \u0442\u043e \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u0439\u0442\u0438 card.uuid \u043f\u043e cards.name = 'Tendo Ice Bridge', \u0437\u0430\u0442\u0435\u043c \u043f\u043e cards.setcode \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c sets.code, \u0437\u0430\u0442\u0435\u043c \u043f\u043e set_translations \u0433\u0434\u0435 setcode = sets.code \u0438 language = 'French' \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c translation. \u041d\u043e \u0435\u0441\u0442\u044c \u043b\u0438 \u0432 foreign_data \u043f\u043e\u043b\u0435 \u0434\u043b\u044f \u0438\u043c\u0435\u043d\u0438 \u0441\u0435\u0442\u0430? \u041d\u0435\u0442, foreign_data \u0434\u043b\u044f \u043a\u0430\u0440\u0442. \u0415\u0441\u0442\u044c set_translations \u0434\u043b\u044f \u0441\u0435\u0442\u043e\u0432.\n\n\u0422\u0430\u043a\u0436\u0435 \u0435\u0441\u0442\u044c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c, \u0447\u0442\u043e \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u043d\u043e\u0435 \u0438\u043c\u044f (French name of the card)? \u041d\u043e \u0437\u0430\u043f\u0440\u043e\u0441 \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \"French name of the set\", \u0430 \u043d\u0435 \u043a\u0430\u0440\u0442\u044b. \u0422\u043e \u0435\u0441\u0442\u044c \u043d\u0443\u0436\u043d\u043e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u0438\u043c\u044f \u0441\u0435\u0442\u0430.\n\n\u041e\u0434\u043d\u0430\u043a\u043e \u0435\u0441\u0442\u044c \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c: \"sets of cards with 'Tendo Ice Bridge' is in\" - \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0438\u043c\u0435\u0435\u0442\u0441\u044f \u0432 \u0432\u0438\u0434\u0443 \u0441\u0435\u0442, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0435\u0441\u0442\u044c \u044d\u0442\u0430 \u043a\u0430\u0440\u0442\u0430. \u041d\u043e \u043a\u0430\u0440\u0442\u044b \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u0441\u0435\u0442\u0430\u0445? \u0412 cards \u0435\u0441\u0442\u044c \u043f\u043e\u043b\u0435 setcode, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043d\u0430 \u043e\u0434\u0438\u043d \u0441\u0435\u0442. \u0423 \u043a\u0430\u0440\u0442\u044b \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u0435\u0447\u0430\u0442\u0435\u0439? \u0412 \u0442\u0430\u0431\u043b\u0438\u0446\u0435 cards, \u0432\u0435\u0440\u043e\u044f\u0442\u043d\u043e, \u043a\u0430\u0436\u0434\u0430\u044f \u0437\u0430\u043f\u0438\u0441\u044c - \u044d\u0442\u043e \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e\u0435 \u0438\u0437\u0434\u0430\u043d\u0438\u0435 \u043a\u0430\u0440\u0442\u044b (\u0441 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u043c uuid). \u0422\u043e \u0435\u0441\u0442\u044c \u043e\u0434\u043d\u0430 \u043a\u0430\u0440\u0442\u0430 \u043c\u043e\u0436\u0435\u0442 \u0438\u043c\u0435\u0442\u044c \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0437\u0430\u043f\u0438\u0441\u0435\u0439 \u0441 \u0440\u0430\u0437\u043d\u044b\u043c\u0438 setcode. \u041d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043a\u0430\u0440\u0442\u0430 \"Tendo Ice Bridge\" \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043f\u0435\u0440\u0435\u0438\u0437\u0434\u0430\u043d\u0430 \u0432 \u0440\u0430\u0437\u043d\u044b\u0445 \u0441\u0435\u0442\u0430\u0445. \u0422\u043e\u0433\u0434\u0430 \u043a\u0430\u043a\u043e\u0439 \u0441\u0435\u0442 \u0438\u043c\u0435\u0435\u0442\u0441\u044f \u0432 \u0432\u0438\u0434\u0443? \u0417\u0430\u043f\u0440\u043e\u0441 \u043d\u0435 \u0443\u0442\u043e\u0447\u043d\u044f\u0435\u0442, \u0432 \u043a\u0430\u043a\u043e\u043c \u0438\u043c\u0435\u043d\u043d\u043e \u0441\u0435\u0442\u0435 - \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043f\u043e\u0434\u0440\u0430\u0437\u0443\u043c\u0435\u0432\u0430\u0435\u0442\u0441\u044f \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u0435\u0442? \u041d\u043e \u0432 \u0434\u0430\u043d\u043d\u044b\u0445 \u043d\u0435\u0442 \u044f\u0432\u043d\u043e\u0433\u043e \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043d\u0430 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u0435\u0442. \u041c\u043e\u0436\u043d\u043e \u0432\u0437\u044f\u0442\u044c \u0432\u0441\u0435 \u0441\u0435\u0442\u044b, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0435\u0441\u0442\u044c \u044d\u0442\u0430 \u043a\u0430\u0440\u0442\u0430, \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0438\u0445 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f. \u041d\u043e \u0437\u0430\u043f\u0440\u043e\u0441 \u0432 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \"the set\" - \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u0435\u0442\u0441\u044f \u043e\u0434\u0438\u043d \u0441\u0435\u0442. \u042d\u0442\u043e \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c, \u0435\u0441\u043b\u0438 \u043a\u0430\u0440\u0442\u0430 \u0435\u0441\u0442\u044c \u0432 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u0441\u0435\u0442\u0430\u0445. \u041d\u043e \u0432 MTG \u043a\u0430\u0436\u0434\u0430\u044f \u043a\u0430\u0440\u0442\u0430 \u0438\u043c\u0435\u0435\u0442 \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0435 \u0438\u043c\u044f, \u0438 \u0447\u0430\u0441\u0442\u043e \u0432\u044b\u043f\u0443\u0441\u043a\u0430\u0435\u0442\u0441\u044f \u0432 \u043e\u0434\u043d\u043e\u043c \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c \u0441\u0435\u0442\u0435, \u043d\u043e \u0431\u044b\u0432\u0430\u044e\u0442 \u043f\u0435\u0440\u0435\u0438\u0437\u0434\u0430\u043d\u0438\u044f. \u041f\u043e\u044d\u0442\u043e\u043c\u0443 \u043d\u0443\u0436\u043d\u043e \u0443\u0442\u043e\u0447\u043d\u0438\u0442\u044c, \u043a\u0430\u043a\u043e\u0439 \u0441\u0435\u0442 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442.\n\n\u0422\u0430\u043a\u0436\u0435 \u0435\u0441\u0442\u044c foreign_data, \u0433\u0434\u0435 \u0445\u0440\u0430\u043d\u044f\u0442\u0441\u044f \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u044b \u043a\u0430\u0440\u0442. \u041c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c, \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u0438\u043c\u044f \u043a\u0430\u0440\u0442\u044b? \u041d\u043e \u0437\u0430\u043f\u0440\u043e\u0441 \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \"French name of the set\", \u0442\u0430\u043a \u0447\u0442\u043e \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e \u043a\u0430\u0440\u0442\u0443.\n\n\u0415\u0441\u0442\u044c evidence: \"French refers to language = 'French'; \"Tendo Ice Bridge\" is a translated name of a card; translated name refers to translation\" \u042d\u0442\u043e evidence \u0443\u0442\u043e\u0447\u043d\u044f\u0435\u0442, \u0447\u0442\u043e French - \u044d\u0442\u043e \u044f\u0437\u044b\u043a French, \u0438 \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u043d\u043e\u0435 \u0438\u043c\u044f \u043a\u0430\u0440\u0442\u044b (\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043d\u0430 \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u043c?). \u0422\u043e \u0435\u0441\u0442\u044c evidence \u0433\u043e\u0432\u043e\u0440\u0438\u0442, \u0447\u0442\u043e \"Tendo Ice Bridge\" \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u043e\u043c \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f \u043a\u0430\u0440\u0442\u044b (translated name). \u0422\u043e\u0433\u0434\u0430 \u044d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u0438\u043c\u044f \u043a\u0430\u0440\u0442\u044b? \u0418\u043b\u0438 \u043d\u0430\u043e\u0431\u043e\u0440\u043e\u0442? \"translated name refers to translation\" - \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0447\u0442\u043e \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u043d\u0430 \u043a\u0430\u043a\u043e\u0439-\u0442\u043e \u044f\u0437\u044b\u043a. \u041d\u043e evidence \u043d\u0435 \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u0447\u0442\u043e \u044d\u0442\u043e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0439. \u041e\u043d\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442, \u0447\u0442\u043e French - \u044d\u0442\u043e \u044f\u0437\u044b\u043a, \u0438 \u0447\u0442\u043e \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u043d\u043e\u0435 \u0438\u043c\u044f. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u044d\u0442\u043e \u0438\u043c\u044f \u043d\u0430 \u0434\u0440\u0443\u0433\u043e\u043c \u044f\u0437\u044b\u043a\u0435, \u0430 \u043c\u044b \u0438\u0449\u0435\u043c \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0441\u0435\u0442\u0430. \u0412 \u043b\u044e\u0431\u043e\u043c \u0441\u043b\u0443\u0447\u0430\u0435, \u043d\u0435\u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0441\u0442\u044c: \u0435\u0441\u043b\u0438 \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u043d\u043e\u0435 \u0438\u043c\u044f (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u043d\u0430 \u044f\u043f\u043e\u043d\u0441\u043a\u0438\u0439), \u0442\u043e \u043a\u0430\u043a \u043d\u0430\u0439\u0442\u0438 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0443\u044e \u043a\u0430\u0440\u0442\u0443? \u041d\u0443\u0436\u043d\u043e \u043d\u0430\u0439\u0442\u0438 \u0432 foreign_data \u0437\u0430\u043f\u0438\u0441\u044c \u0441 name = 'Tendo Ice Bridge' \u0438 language = ? \u041d\u043e \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u043e, \u043d\u0430 \u043a\u0430\u043a\u043e\u043c \u044f\u0437\u044b\u043a\u0435 \u044d\u0442\u043e \u0438\u043c\u044f. \u041c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c, \u044d\u0442\u043e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u0438\u043c\u044f? \u041d\u043e evidence \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \"French refers to language = 'French'\", \u043d\u043e \u043d\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u0442, \u0447\u0442\u043e \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u0438\u043c\u044f. \u041e\u043d\u043e \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \"Tendo Ice Bridge\" is a translated name of a card\", \u0442\u043e \u0435\u0441\u0442\u044c \u044d\u0442\u043e \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0435\u043d\u043d\u043e\u0435 \u0438\u043c\u044f, \u043d\u043e \u044f\u0437\u044b\u043a \u043d\u0435 \u0443\u043a\u0430\u0437\u0430\u043d. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u044d\u0442\u043e \u0438\u043c\u044f \u043d\u0430 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u043c? \"translated name\" \u043c\u043e\u0436\u0435\u0442 \u043e\u0437\u043d\u0430\u0447\u0430\u0442\u044c, \u0447\u0442\u043e \u044d\u0442\u043e \u0438\u043c\u044f - \u043f\u0435\u0440\u0435\u0432\u043e\u0434 \u0441 \u0434\u0440\u0443\u0433\u043e\u0433\u043e \u044f\u0437\u044b\u043a\u0430. \u041d\u043e \u0442\u043e\u0433\u0434\u0430 \u043d\u0435\u044f\u0441\u043d\u043e, \u043a\u0430\u043a \u043d\u0430\u0439\u0442\u0438 \u043a\u0430\u0440\u0442\u0443.\n\n\u0420\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0438\u043c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435 \u0438\u043d\u0442\u0435\u0440\u043f\u0440\u0435\u0442\u0430\u0446\u0438\u0438:\n1) \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0435 \u0438\u043c\u044f \u043a\u0430\u0440\u0442\u044b (\u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b). \u0422\u043e\u0433\u0434\u0430 \u043c\u044b \u0438\u0449\u0435\u043c \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0441\u0435\u0442\u0430, \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0449\u0435\u0433\u043e \u044d\u0442\u0443 \u043a\u0430\u0440\u0442\u0443.\n2) \"Tendo Ice Bridge\" - \u044d\u0442\u043e \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u0435 \u0438\u043c\u044f \u043a\u0430\u0440\u0442\u044b (\u043f\u0435\u0440\u0435\u0432\u043e\u0434). \u0422\u043e\u0433\u0434\u0430 \u043c\u044b \u0434\u043e\u043b\