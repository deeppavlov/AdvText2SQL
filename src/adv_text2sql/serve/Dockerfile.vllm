# vLLM с поддержкой LoRA-адаптеров для autonomous Text2SQL.
#
# Образ принимает базовую модель + LoRA-адаптер и поднимает OpenAI-compatible
# API на 8000. vLLM сам делает merging on-the-fly — не нужно заранее мерджить
# веса в GGUF, можно держать только LoRA-веса (~150 MB вместо 4.7 GB).
#
# Параметры через env:
#   BASE_MODEL    — HF id базовой модели (default: Qwen/Qwen2.5-Coder-7B-Instruct)
#   ADAPTER_NAME  — имя адаптера для --lora-modules (default: text2sql)
#   ADAPTER_PATH  — путь к адаптеру в контейнере (default: /adapters/active)
#   MAX_MODEL_LEN — максимальная длина контекста (default: 8192)
#
# Запуск:
#   docker run --gpus all -p 8000:8000 \
#     -v $(pwd)/models/card_games/adapter:/adapters/active \
#     -e ADAPTER_NAME=card_games \
#     text2sql-vllm:latest

FROM vllm/vllm-openai:latest

ENV BASE_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
ENV ADAPTER_NAME=text2sql
ENV ADAPTER_PATH=/adapters/active
ENV MAX_MODEL_LEN=8192
ENV TENSOR_PARALLEL_SIZE=1

# Entry-point: запускаем vLLM с loaded LoRA-адаптером
ENTRYPOINT ["bash", "-c", "\
  python3 -m vllm.entrypoints.openai.api_server \
    --model $BASE_MODEL \
    --enable-lora \
    --lora-modules $ADAPTER_NAME=$ADAPTER_PATH \
    --max-model-len $MAX_MODEL_LEN \
    --tensor-parallel-size $TENSOR_PARALLEL_SIZE \
    --host 0.0.0.0 \
    --port 8000 \
"]
